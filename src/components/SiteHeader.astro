---
const { phone = "(918) 734-3331" } = Astro.props;
const telHref = `tel:${phone.replace(/[^0-9]/g, "")}`;

// ✅ Grouped props for “Properties” mega menu
const propertyGroups = [
  {
    title: "Panama City Beach",
    items: [
      { href: "/properties/heavenly-hideaway/", label: "Heavenly Hideaway" },
      { href: "/properties/sailors-delight/", label: "Sailor’s Delight" },
      { href: "/properties/red-sky-nights/", label: "Red Sky Nights" },
    ],
  },
  {
    title: "Destin / Okaloosa",
    items: [
      { href: "/properties/destin-dreams/", label: "Destin Dreams" },
      { href: "/properties/destin-diamond/", label: "Destin Diamond" },
      { href: "/properties/fanta-sea/", label: "Fanta Sea" },
    ],
  },
];

// ✅ Inline SVG icons (single source of truth)
const ICONS = {
  home: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V21a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>`,
  props: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10.5L12 4l8 6.5V20" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9.5 20v-6h5v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>`,
  tour: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v10H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 17l-2 4m10-4 2 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M10 10l5 2-5 2z" fill="currentColor"/></svg>`,
  map: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6-5.1-6-11a6 6 0 1 1 12 0c0 5.9-6 11-6 11z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 10.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" fill="currentColor"/></svg>`,
  cal: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3M17 3v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M4 7h16v14H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M4 11h16" fill="none" stroke="currentColor" stroke-width="2"/></svg>`,
  reviews: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12c0 4-3.6 7-8 7-1.1 0-2.2-.2-3.2-.6L3 20l1.6-4.3C3.6 14.6 3 13.4 3 12c0-4 3.6-7 8-7s10 3 10 7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M7 12h.01M12 12h.01M17 12h.01" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>`,
  quote: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10l4 4v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M17 3v5h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8 12h8M8 16h8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`,
  phone: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h3l2 6-2 1c1 2.5 3.5 5 6 6l1-2 6 2v3c0 1.1-.9 2-2 2C10.3 20 4 13.7 4 6c0-1.1.9-2 2-2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>`,
  caret: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 6 5-6z" fill="currentColor"/></svg>`,
  x: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`,
};
---

<header class="hdr site-header" data-header>
  <div class="bar">
    <!-- LEFT -->
    <div class="left">
      <button
        class="hamburger"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <span class="hb"></span>
        <span class="hb"></span>
        <span class="hb"></span>
      </button>

      <nav class="nav" aria-label="Primary">
        <a class="link" href="/">Home</a>

        <!-- ✅ Properties mega menu -->
        <div class="dropdown mega" data-dropdown>
          <button class="link dropbtn" type="button" aria-haspopup="true">
            Properties
            <span class="caret" set:html={ICONS.caret}></span>
          </button>

          <div class="megaPanel" role="menu" aria-label="Properties menu">
            <a class="megaAll" href="/properties/">
              View all properties →
            </a>

            <div class="megaGrid">
              {propertyGroups.map((group) => (
                <div class="megaGroup">
                  <div class="megaHeading">{group.title}</div>
                  {group.items.map((p) => (
                    <a role="menuitem" class="megaLink" href={p.href}>
                      {p.label}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>

        <a class="link" href="/3d-condo-tours/">3D Condo Tours</a>
        <a class="link" href="/map/">Map</a>
        <a class="link" href="/availability/">Availability</a>
        <a class="link" href="/reviews/">Reviews</a>
      </nav>
    </div>

    <!-- RIGHT -->
    <div class="right">
      <a class="contact" href={telHref}>{phone}</a>
      <a class="quote" href="/quote/">QUOTE / PRICING</a>
    </div>
  </div>

  <!-- ✅ MOBILE OVERLAY + DRAWER -->
  <div class="backdrop" data-backdrop></div>

  <aside class="drawer" aria-label="Mobile menu">
    <div class="drawerTop">
      <button class="closeBtn" type="button" aria-label="Close menu">
        <span class="ico" set:html={ICONS.x}></span>
      </button>

      <a class="drawerQuote" href="/quote/">
        <span class="ico" set:html={ICONS.quote}></span>
        Quote / Pricing
      </a>
    </div>

    <div class="drawerBody">
      <a class="ditem" href="/">
        <span class="ico" set:html={ICONS.home}></span>
        Home
      </a>

      <details class="dsection">
        <summary>
          <span class="sumLeft">
            <span class="ico" set:html={ICONS.props}></span>
            Properties
          </span>
          <span class="sumCaret" set:html={ICONS.caret}></span>
        </summary>

        <div class="dsub">
          <a class="dsubLink all" href="/properties/">
            View all properties →
          </a>

          {propertyGroups.map((group) => (
            <div class="dgroup">
              <div class="dgroupTitle">{group.title}</div>
              <div class="dgroupLinks">
                {group.items.map((p) => (
                  <a class="dsubLink" href={p.href}>{p.label}</a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </details>

      <a class="ditem" href="/3d-condo-tours/">
        <span class="ico" set:html={ICONS.tour}></span>
        3D Condo Tours
      </a>

      <a class="ditem" href="/map/">
        <span class="ico" set:html={ICONS.map}></span>
        Map
      </a>

      <a class="ditem" href="/availability/">
        <span class="ico" set:html={ICONS.cal}></span>
        Availability
      </a>

      <a class="ditem" href="/reviews/">
        <span class="ico" set:html={ICONS.reviews}></span>
        Reviews
      </a>

      <a class="ditem" href={telHref}>
        <span class="ico" set:html={ICONS.phone}></span>
        {phone}
      </a>
    </div>
  </aside>

  <script is:inline>
    const header = document.querySelector("[data-header]");
    const burgerBtn = header.querySelector(".hamburger");
    const drawer = header.querySelector(".drawer");
    const closeBtn = header.querySelector(".closeBtn");
    const backdrop = header.querySelector("[data-backdrop]");

    function setOpen(open) {
      burgerBtn.classList.toggle("open", open);
      drawer.classList.toggle("open", open);
      backdrop.classList.toggle("open", open);
      burgerBtn.setAttribute("aria-expanded", open ? "true" : "false");
      document.documentElement.classList.toggle("nav-locked", open);
    }

    burgerBtn.addEventListener("click", () => setOpen(!drawer.classList.contains("open")));
    closeBtn?.addEventListener("click", () => setOpen(false));
    backdrop?.addEventListener("click", () => setOpen(false));

    // Close on ESC
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });

    // Close drawer after tapping a link (better UX on mobile)
    drawer.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => setOpen(false));
    });

    // Sticky header styling
    window.addEventListener("scroll", () => {
      header.classList.toggle("is-scrolled", window.scrollY > 10);
    });
  </script>

  <style>
    .hdr,
    .hdr * {
      font-family: var(--font-nav, "Quicksand", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif) !important;
    }

    .hdr {
      position: sticky;
      top: 0;
      z-index: 999;
      background: #fff;
      border-bottom: 1px solid rgba(0,0,0,.1);
      color: var(--brand-blue, #193e7f);
    }

    .hdr.is-scrolled {
      background: rgba(255,255,255,.8);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .bar {
      max-width: 1440px;
      margin: 0 auto;
      padding: 18px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .left {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .nav {
      display: flex;
      gap: 14px;
      align-items: center;
    }

    .link {
      text-decoration: none;
      padding: 12px 14px;
      border-radius: 12px;
      font-weight: 600;
      color: inherit;
      white-space: nowrap;
    }

    .link:hover {
      background: rgba(0,0,0,.05);
    }

    /* ✅ Dropdown / Mega */
    .dropdown { position: relative; }
    .dropbtn {
      background: none;
      border: 0;
      font: inherit;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .caret svg { width: 18px; height: 18px; display: block; }

    /* keeps hover open while moving into dropdown */
    .dropdown::after {
      content: "";
      position: absolute;
      left: 0;
      top: 100%;
      width: 100%;
      height: 14px;
    }

    /* ✅ Mega panel (separate class so old styles can’t interfere) */
    .megaPanel{
      display: none;
      position: absolute;
      top: calc(100% + 14px);
      left: 0;
      width: 640px;
      max-width: min(640px, calc(100vw - 28px));
      background: #fff;
      border-radius: 18px;
      border: 1px solid rgba(0,0,0,.10);
      box-shadow: 0 18px 44px rgba(0,0,0,.14);
      padding: 12px;
      z-index: 1000;
    }

    .dropdown.mega:hover .megaPanel,
    .dropdown.mega:focus-within .megaPanel{
      display: block;
    }

    .megaAll{
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      border-radius: 14px;
      text-decoration: none;
      font-weight: 900;
      color: rgba(25,62,127,.92);
      background: rgba(25,62,127,.06);
      border: 1px solid rgba(25,62,127,.12);
      margin-bottom: 12px;
    }
    .megaAll:hover{
      background: rgba(25,62,127,.10);
      color: var(--brand-blue, #193e7f);
    }

    .megaGrid{
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .megaGroup{
      padding: 12px;
      border-radius: 16px;
      border: 1px solid rgba(0,0,0,.08);
      background: rgba(0,0,0,.02);
    }

    .megaHeading{
      font-weight: 900;
      letter-spacing: .10em;
      font-size: 12px;
      text-transform: uppercase;
      color: rgba(25,62,127,.75);
      margin: 2px 2px 10px;
    }

    .megaLink{
      display: block;
      padding: 10px 12px;
      border-radius: 14px;
      text-decoration: none;
      color: inherit;
      font-weight: 750;
    }
    .megaLink:hover{
      background: rgba(25,62,127,.08);
    }

    @media (max-width: 720px){
      .megaPanel{ width: calc(100vw - 28px); }
      .megaGrid{ grid-template-columns: 1fr; }
    }

    .right {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .contact {
      font-weight: 600;
      text-decoration: underline;
      color: inherit;
    }

    .quote {
      padding: 14px 18px;
      border-radius: 16px;
      border: 2px solid currentColor;
      font-weight: 700;
      text-decoration: none;
      color: inherit;
      transition: all .2s ease;
      white-space: nowrap;
    }

    .quote:hover {
      background: currentColor;
      color: #fff;
    }

    /* ✅ Hamburger */
    .hamburger {
      display: none;
      position: relative !important;
      width: 56px !important;
      height: 56px !important;
      padding: 0 !important;
      border-radius: 14px !important;
      border: 2px solid rgba(25,62,127,.35) !important;
      background: #fff !important;
      cursor: pointer !important;
      align-items: center !important;
      justify-content: center !important;
      -webkit-tap-highlight-color: transparent;
      color: var(--brand-blue, #193e7f) !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    .hamburger .hb {
      display: block !important;
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      width: 28px !important;
      height: 3px !important;
      background: var(--brand-blue, #193e7f) !important;
      border-radius: 999px !important;
      opacity: 1 !important;
      visibility: visible !important;
      transform-origin: center !important;
      transition: transform .25s ease, opacity .2s ease !important;
    }

    .hamburger .hb:nth-child(1) { transform: translate(-50%, calc(-50% - 8px)) !important; }
    .hamburger .hb:nth-child(2) { transform: translate(-50%, -50%) !important; }
    .hamburger .hb:nth-child(3) { transform: translate(-50%, calc(-50% + 8px)) !important; }

    .hamburger.open .hb:nth-child(1) { transform: translate(-50%, -50%) rotate(45deg) !important; }
    .hamburger.open .hb:nth-child(2) { opacity: 0 !important; }
    .hamburger.open .hb:nth-child(3) { transform: translate(-50%, -50%) rotate(-45deg) !important; }

    .site-header.is-scrolled .hamburger {
      background: var(--brand-blue, #193e7f) !important;
      border-color: var(--brand-blue, #193e7f) !important;
    }
    .site-header.is-scrolled .hamburger .hb { background: #fff !important; }

    /* ✅ Mobile drawer + overlay */
    .backdrop{
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.35);
      backdrop-filter: blur(2px);
      z-index: 998;
    }
    .backdrop.open{ display: block; }

    .drawer{
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      height: 100dvh;
      width: min(420px, 92vw);
      background: #fff;
      z-index: 999;
      border-right: 1px solid rgba(0,0,0,.10);
      box-shadow: 0 22px 60px rgba(0,0,0,.20);
      transform: translateX(-12px);
      opacity: 0;
      transition: transform .18s ease, opacity .18s ease;
      overflow: hidden;
    }
    .drawer.open{
      display: block;
      transform: translateX(0);
      opacity: 1;
    }

    .drawerTop{
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 14px;
      border-bottom: 1px solid rgba(0,0,0,.08);
    }

    .closeBtn{
      width: 48px;
      height: 48px;
      border-radius: 14px;
      border: 1px solid rgba(25,62,127,.25);
      background: #fff;
      color: var(--brand-blue, #193e7f);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .closeBtn svg{ width: 22px; height: 22px; }

    .drawerQuote{
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 14px;
      border-radius: 16px;
      border: 2px solid var(--brand-blue, #193e7f);
      font-weight: 900;
      text-decoration: none;
      color: var(--brand-blue, #193e7f);
      background: rgba(25,62,127,.04);
    }
    .drawerQuote:hover{ background: rgba(25,62,127,.08); }
    .drawerQuote svg{ width: 20px; height: 20px; }

    .drawerBody{
      padding: 8px 10px 18px;
      overflow: auto;
      height: calc(100dvh - 78px);
    }

    .ico{
      width: 22px;
      height: 22px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: rgba(25,62,127,.92);
      flex: 0 0 auto;
    }
    .ico svg{ width: 22px; height: 22px; display: block; }

    .ditem{
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 12px;
      border-radius: 16px;
      text-decoration: none;
      color: var(--brand-blue, #193e7f);
      font-weight: 800;
    }
    .ditem:hover{ background: rgba(25,62,127,.06); }

    .dsection{
      margin: 8px 0;
      border-radius: 16px;
      border: 1px solid rgba(0,0,0,.08);
      overflow: hidden;
      background: rgba(0,0,0,.01);
    }

    .dsection summary{
      list-style: none;
      cursor: pointer;
      padding: 14px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      font-weight: 900;
      color: var(--brand-blue, #193e7f);
      user-select: none;
    }
    .dsection summary::-webkit-details-marker{ display: none; }

    .sumLeft{
      display: inline-flex;
      align-items: center;
      gap: 12px;
    }
    .sumCaret svg{ width: 18px; height: 18px; transition: transform .18s ease; }
    details[open] .sumCaret svg{ transform: rotate(180deg); }

    .dsub{ padding: 8px 10px 12px; }

    .dsubLink{
      display: block;
      padding: 12px 12px;
      border-radius: 14px;
      text-decoration: none;
      color: rgba(25,62,127,.92);
      font-weight: 800;
    }
    .dsubLink:hover{ background: rgba(25,62,127,.06); }

    .dsubLink.all{
      background: rgba(25,62,127,.06);
      border: 1px solid rgba(25,62,127,.10);
      margin-bottom: 10px;
    }

    .dgroup{ margin-top: 8px; }
    .dgroupTitle{
      padding: 8px 8px 6px;
      font-weight: 900;
      letter-spacing: .10em;
      font-size: 12px;
      text-transform: uppercase;
      color: rgba(25,62,127,.70);
    }

    .dgroupLinks{
      display: grid;
      gap: 6px;
    }

    /* Lock page scroll when drawer is open */
    :global(html.nav-locked),
    :global(body.nav-locked){
      overflow: hidden !important;
    }

    @media (max-width: 1100px) {
      .nav { display: none; }
      .hamburger { display: inline-flex; }
      .contact { display: none; }
    }
  </style>
</header>