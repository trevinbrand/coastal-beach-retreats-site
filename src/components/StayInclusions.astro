---
interface Props {
  items: string[];
  note?: string;
}
const { items, note } = Astro.props;
---

<section class="stay-inclusions" aria-labelledby="stay-inclusions-heading">
  <h2 id="stay-inclusions-heading">What’s included with your stay</h2>
  <ul>
    {items.map((item) => <li>{item}</li>)}
  </ul>
  {note && <p>{note}</p>}
</section>

<style>
  .stay-inclusions {
    margin: 0 0 30px;
    padding: 22px;
    border: 1px solid #dce5df;
    border-radius: 8px;
    background: #edf2ef;
  }
  h2 {
    margin: 0 0 14px;
    color: #193e7f;
    font-family: var(--font-nav);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 10px 28px;
    margin: 0;
    padding-left: 20px;
    color: #45534c;
    font-size: 15px;
    line-height: 1.6;
  }
  li::marker { color: #058789; }
  p { margin: 16px 0 0; color: #45534c; font-size: 14px; line-height: 1.6; }
</style>
