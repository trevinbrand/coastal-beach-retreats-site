---
const { p } = Astro.props;
---

<section class="block" aria-label={p.name}>
  <div class="card">
    <div class="img">
      <a class="imgLink" href={p.href} aria-label={`View ${p.name}`}>
        <img
          src={p.image}
          alt={p.name}
          loading={p.id === "destin-dreams" ? "eager" : "lazy"}
        />
      </a>
    </div>

    <div class="text">
      <h3 class="title">
        <a href={p.href}>{p.name}</a>
      </h3>

      <div class="meta">
        <div><strong>Size –</strong> <span>{p.sizeLine}</span></div>
        <div><strong>Amenities –</strong> <span>{p.amenitiesLine}</span></div>
      </div>

      <p class="blurb">{p.blurb}</p>

      {p.noteBold 
        ? <p class="note"><strong>{p.noteBold}</strong></p> 
        : <p class="note note-empty"></p>
      }

      <div class="actions">
        <a class="btn" href={p.photosHref}>Photos</a>
        <a class="btn" href={p.availabilityHref}>Availability</a>
        <a class="btn primary" href={p.detailsHref}>Details</a>
        <a class="btn" href={p.href}>Inquire</a>
      </div>
    </div>
  </div>

  <style>
    .block {
      width: 100%;
      margin: 0;
      padding: 0;
      position: relative;
      isolation: isolate;
      height: 100%;
    }

    .card {
      display: flex;
      flex-direction: column;
      height: 100%;
      border: 1px solid rgba(0, 0, 0, 0.08);
      background: #fff;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
      overflow: hidden;
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
      border-color: rgba(25, 62, 127, 0.14);
    }

    .img {
      width: 100%;
      overflow: hidden;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      background: rgba(0, 0, 0, 0.03);
      position: relative;
      z-index: 2;
    }

    .imgLink {
      display: block;
      width: 100%;
      text-decoration: none;
      position: relative;
      z-index: 3;
    }

    .img img {
      display: block;
      width: 100%;
      height: 250px;
      object-fit: cover;
      border-radius: 0 !important;
      transition: transform 0.28s ease;
    }

    .imgLink:hover img {
      transform: scale(1.02);
    }

    .text {
      display: flex;
      flex-direction: column;
      flex: 1;
      padding: 14px;
      position: relative;
      z-index: 1;
    }

    .title {
      margin: 0 0 8px;
      font-size: 21px;
      line-height: 1.18;
      font-family: "Dancing Script", cursive;
      color: #193e7f;
      font-weight: 600;
    }

    .title a {
      text-decoration: none;
      color: inherit;
    }

    .title a:hover {
      opacity: 0.86;
    }

    .meta {
      display: grid;
      gap: 4px;
      margin: 0 0 12px;
      font-size: 14px;
      line-height: 1.45;
      opacity: 0.92;
    }

    .meta strong {
      color: #058789;
      font-weight: 700;
    }

    .blurb {
      margin: 0;
      font-size: 15px;
      line-height: 1.65;
      color: rgba(0, 0, 0, 0.82);

      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: 96px;
    }

    .note {
      margin: 12px 0 0;
      font-size: 15px;
      line-height: 1.55;
      color: rgba(0, 0, 0, 0.9);

      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: 46px;
    }

    .note-empty {
      visibility: hidden;
    }

    .actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: auto;
      padding-top: 14px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      border: 1px solid rgba(0, 0, 0, 0.16);
      padding: 8px 12px;
      border-radius: 10px;
      font-size: 14px;
      color: rgba(0, 0, 0, 0.82);
      background: #fff;
      transition: all 0.18s ease;
      min-height: 40px;
    }

    .btn:hover {
      background: rgba(0, 0, 0, 0.04);
      border-color: rgba(0, 0, 0, 0.28);
    }

    .btn.primary {
      background: #193e7f;
      color: #fff;
      border-color: #193e7f;
    }

    .btn.primary:hover {
      background: #16376f;
      border-color: #16376f;
    }

    @media (max-width: 980px) {
      .img img {
        height: 230px;
      }

      .title {
        font-size: 20px;
      }
    }

    @media (max-width: 640px) {
      .text {
        padding: 12px;
      }

      .img img {
        height: 220px;
      }

      .title {
        font-size: 20px;
      }

      .blurb {
        -webkit-line-clamp: 5;
      }

      .actions {
        gap: 8px;
      }

      .btn {
        padding: 8px 11px;
        font-size: 14px;
      }
    }
  </style>
</section>