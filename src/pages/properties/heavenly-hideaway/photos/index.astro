---
/**
 * FILE: src/pages/properties/heavenly-hideaway/photos/index.astro
 * Full Photos page for Heavenly Hideaway
 * - Uses thumb-h1.webp ... thumb-h35.webp for gallery thumbnails
 * - Uses h1.jpeg ... h35.jpeg for full-size lightbox images
 */
import "../../../../styles/global.css";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";

const PHOTO_COUNT = 35;
const PHOTO_BASE = "/images/props/heavenly-hideaway";

const pageTitle = "Heavenly Hideaway Photos";
const subtitle =
  "All photos for Tower 1-1106 at Edgewater — tap any image to view and scroll through the gallery.";
const backHref = "/properties/heavenly-hideaway/";

const galleryPhotos = Array.from({ length: PHOTO_COUNT }, (_, i) => {
  const n = i + 1;
  return {
    full: `${PHOTO_BASE}/h${n}.jpeg`,
    thumb: `${PHOTO_BASE}/thumb-h${n}.webp`,
    alt: `Heavenly Hideaway photo ${n}`,
  };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle} | Coastal Beach Retreats</title>
    <meta name="description" content="Full photo gallery for Heavenly Hideaway." />
  </head>

  <body>
    <SiteHeader phone="(918) 734-3331" />

    <main class="wrap">
      <header class="titlebar">
        <div class="topRow">
          <div>
            <h1 class="h1">{pageTitle}</h1>
            <p class="sub">{subtitle}</p>
          </div>

          <a class="btnBack" href={backHref} aria-label="Back to property page">
            ← Back to Property
          </a>
        </div>
      </header>

      <section class="card" aria-label="Photo gallery">
        <div class="galleryGrid">
          {galleryPhotos.map((ph, i) => (
            <button
              class="gItem"
              type="button"
              data-index={i}
              aria-label={`Open ${ph.alt}`}
            >
              <img
                src={ph.thumb}
                alt={ph.alt}
                loading={i < 4 ? "eager" : "lazy"}
                fetchpriority={i < 4 ? "high" : "auto"}
                decoding="async"
                width="800"
                height="533"
              />
            </button>
          ))}
        </div>
      </section>
    </main>

    <div
      class="lightbox"
      id="lightbox"
      aria-hidden="true"
      role="dialog"
      aria-label="Photo gallery viewer"
    >
      <button class="lbClose" id="lbClose" type="button" aria-label="Close gallery">×</button>

      <button class="lbArrow lbPrev" id="lbPrev" type="button" aria-label="Previous photo">‹</button>

      <div class="lbStage" id="lbStage">
        <img id="lbImage" src="" alt="" />
        <div class="lbCount" id="lbCount"></div>
      </div>

      <button class="lbArrow lbNext" id="lbNext" type="button" aria-label="Next photo">›</button>
    </div>

    <SiteFooter phone="(918) 734-3331" email="coastalbeachretreats@gmail.com" />

    <script is:inline define:vars={{ galleryPhotos }}>
      (() => {
        const photos = JSON.parse(JSON.stringify(galleryPhotos || []));
        const items = Array.from(document.querySelectorAll(".gItem"));
        const lightbox = document.getElementById("lightbox");
        const lbImage = document.getElementById("lbImage");
        const lbCount = document.getElementById("lbCount");
        const lbClose = document.getElementById("lbClose");
        const lbPrev = document.getElementById("lbPrev");
        const lbNext = document.getElementById("lbNext");
        const lbStage = document.getElementById("lbStage");

        if (!photos.length || !lightbox || !lbImage || !lbCount) return;

        let current = 0;
        let startX = 0;
        let startY = 0;
        let lastFocused = null;

        function render(index) {
          current = (index + photos.length) % photos.length;
          const photo = photos[current];
          lbImage.src = photo.full;
          lbImage.alt = photo.alt;
          lbCount.textContent = `${current + 1} / ${photos.length}`;
        }

        function openLightbox(index) {
          lastFocused = document.activeElement;
          render(index);
          lightbox.classList.add("is-open");
          lightbox.setAttribute("aria-hidden", "false");
          document.body.classList.add("lbOpen");
        }

        function closeLightbox() {
          lightbox.classList.remove("is-open");
          lightbox.setAttribute("aria-hidden", "true");
          document.body.classList.remove("lbOpen");
          lbImage.src = "";
          lbImage.alt = "";

          if (lastFocused && typeof lastFocused.focus === "function") {
            lastFocused.focus();
          }
        }

        function nextPhoto() {
          render(current + 1);
        }

        function prevPhoto() {
          render(current - 1);
        }

        items.forEach((item) => {
          item.addEventListener("click", () => {
            const index = Number(item.dataset.index || 0);
            openLightbox(index);
          });
        });

        lbClose?.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          closeLightbox();
        });

        lbNext?.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          nextPhoto();
        });

        lbPrev?.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          prevPhoto();
        });

        lightbox.addEventListener("click", (e) => {
          if (e.target === lightbox) {
            closeLightbox();
          }
        });

        document.addEventListener("keydown", (e) => {
          if (!lightbox.classList.contains("is-open")) return;

          if (e.key === "Escape") closeLightbox();
          if (e.key === "ArrowRight") nextPhoto();
          if (e.key === "ArrowLeft") prevPhoto();
        });

        lbStage?.addEventListener(
          "touchstart",
          (e) => {
            const t = e.touches?.[0];
            if (!t) return;
            startX = t.clientX;
            startY = t.clientY;
          },
          { passive: true }
        );

        lbStage?.addEventListener(
          "touchend",
          (e) => {
            const t = e.changedTouches?.[0];
            if (!t) return;

            const dx = t.clientX - startX;
            const dy = t.clientY - startY;

            if (Math.abs(dx) > 50 && Math.abs(dy) < 80) {
              if (dx < 0) nextPhoto();
              else prevPhoto();
            }
          },
          { passive: true }
        );
      })();
    </script>

    <style>
      .wrap {
        max-width: 1440px;
        margin: 0 auto;
        padding: 12px 10px;
      }

      .titlebar { margin: 10px 0 14px; }

      .topRow {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
      }

      .h1 {
        margin: 0 0 6px;
        font-size: 34px;
        line-height: 1.1;
        color: var(--brand-blue, #193e7f);
      }

      .sub {
        margin: 0;
        opacity: .85;
        max-width: 860px;
      }

      .btnBack {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,.12);
        background: #fff;
        text-decoration: none;
        font-weight: 900;
        color: rgba(25,62,127,.9);
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
        white-space: nowrap;
      }
      .btnBack:hover { color: var(--brand-blue, #193e7f); }

      .card {
        border: 1px solid rgba(0,0,0,.12);
        border-radius: 16px;
        padding: 14px;
        background: #fff;
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
      }

      .galleryGrid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
      }

      .gItem {
        display: block;
        width: 100%;
        padding: 0;
        border-radius: 0;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,.12);
        background: rgba(0,0,0,.04);
        cursor: zoom-in;
        content-visibility: auto;
        contain-intrinsic-size: 220px;
      }

      .gItem img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        display: block;
      }

      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0, 0, 0, 0.92);
        display: none;
        align-items: center;
        justify-content: center;
      }

      .lightbox.is-open {
        display: flex;
      }

      .lbStage {
        position: relative;
        max-width: min(92vw, 1400px);
        max-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .lbStage img {
        max-width: 92vw;
        max-height: 90vh;
        width: auto;
        height: auto;
        display: block;
        object-fit: contain;
        box-shadow: 0 12px 36px rgba(0,0,0,.35);
      }

      .lbClose {
        position: absolute;
        top: 16px;
        right: 18px;
        width: 46px;
        height: 46px;
        border: 0;
        border-radius: 999px;
        background: rgba(255,255,255,.14);
        color: #fff;
        font-size: 32px;
        line-height: 1;
        cursor: pointer;
        z-index: 3;
      }

      .lbArrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 52px;
        height: 52px;
        border: 0;
        border-radius: 999px;
        background: rgba(255,255,255,.14);
        color: #fff;
        font-size: 34px;
        line-height: 1;
        cursor: pointer;
        z-index: 3;
      }

      .lbPrev { left: 18px; }
      .lbNext { right: 18px; }

      .lbCount {
        position: absolute;
        left: 50%;
        bottom: 16px;
        transform: translateX(-50%);
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(0,0,0,.55);
        color: #fff;
        font-weight: 800;
        font-size: 14px;
      }

      body.lbOpen {
        overflow: hidden;
      }

      @media (max-width: 980px) {
        .wrap { padding: 12px 12px; }
        .galleryGrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .gItem img { height: 190px; }
      }

      @media (max-width: 640px) {
        .lbArrow {
          width: 44px;
          height: 44px;
          font-size: 28px;
        }

        .lbPrev { left: 10px; }
        .lbNext { right: 10px; }

        .lbClose {
          top: 10px;
          right: 10px;
          width: 42px;
          height: 42px;
          font-size: 28px;
        }
      }

      @media (max-width: 520px) {
        .galleryGrid { grid-template-columns: 1fr; }
        .gItem img { height: 240px; }
      }
    </style>
  </body>
</html>