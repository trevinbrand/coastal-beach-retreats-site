---
/**
 * FILE: src/pages/properties/heavenly-hideaway/index.astro
 * UPDATED FOR FASTER PHOTO LOADING:
 * - Uses .webp for all images
 * - Preloads the first hero image
 * - Uses fetchpriority="high" on the first/top image
 * - Keeps mobile slider and desktop collage layout
 * - OwnerRez widget still loads once at the bottom
 */
import "../../../styles/global.css";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

// ✅ Photo setup (h1.webp ... h35.webp)
const PHOTO_COUNT = 35;

// ✅ Update this folder if needed
const PHOTO_BASE = "/images/props/heavenly-hideaway";

// ✅ Where the separate photos page lives:
const PHOTOS_PAGE_HREF = "/properties/heavenly-hideaway/photos/";

// ✅ Precompute strings used in attributes
const photosCountAria = `${PHOTO_COUNT} photos`;

// Build full list
const galleryPhotos = Array.from({ length: PHOTO_COUNT }, (_, i) => {
  const n = i + 1;
  return {
    src: `${PHOTO_BASE}/h${n}.webp`,
    alt: `Heavenly Hideaway Edgewater Tower 1-1106 Panama City Beach condo photo ${n}`,
  };
});

// Collage uses first 5 (desktop/tablet)
const photosTop = galleryPhotos.slice(0, 5);

const pageTitle =
  "Heavenly Hideaway @ Edgewater Tower 1-1106 | Panama City Beach Condo Rental";
const subtitle =
  "Deluxe Gulf-front Edgewater condo with lagoon views, resort amenities, and sleeping for up to 10.";

// These show ABOVE the description like your screenshot
const sizeLine = "2 Bedrooms • 2 Bathrooms • Sleeps 1-10";
const amenitiesLine = ["Internet", "Oceanfront", "Hot Tub"];
