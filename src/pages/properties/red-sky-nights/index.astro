---
/**
 * FILE: src/pages/properties/red-sky-nights/index.astro
 * UPDATED FOR FASTER PHOTO LOADING:
 * - Uses .webp for all images
 * - Preloads the first hero image
 * - Uses fetchpriority="high" on the first/top image
 * - Keeps mobile slider and desktop collage layout
 * - OwnerRez widget still loads once at the bottom
 */
import "../../../styles/global.css";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

// ✅ Photo setup (RSN1.webp ... RSN45.webp)
const PHOTO_COUNT = 45;
const PHOTO_BASE = "/images/props/red-sky-nights";
const PHOTOS_PAGE_HREF = "/properties/red-sky-nights/photos/";
const photosCountAria = `${PHOTO_COUNT} photos`;

// Build full list
const galleryPhotos = Array.from({ length: PHOTO_COUNT }, (_, i) => {
  const n = i + 1;
  return {
    src: `${PHOTO_BASE}/RSN${n}.webp`,
    alt: `Red Sky Nights Edgewater Tower 1-1002 Panama City Beach condo photo ${n}`,
  };
});

// Collage uses first 5
const photosTop = galleryPhotos.slice(0, 5);

const pageTitle =
  "Red Sky Nights @ Edgewater Tower 1-1002 | Panama City Beach Condo Rental";
const subtitle =
  "Deluxe tenth-floor Edgewater condo with Gulf and lagoon views, full resort amenities, and sleeps up to 10.";

// These show ABOVE the description
const sizeLine = "2 Bedrooms • 2 Bathrooms • Sleeps 1-10";
const amenitiesLine = ["Internet", "Oceanfront", "Hot Tub"];

// ✅ OwnerRez (Red Sky Nights)
const OR_PROPERTY_ID = "4c1b9a39c3e44c929cf198773a243ea3";
const OR_BOOKING_WIDGET_ID = "5d64f7bc08a94f63bf97dec0fa67b864";
const OR_REVIEWS_WIDGET_ID = "4890e07b74de4687afea0375b876245e";
const OR_CALENDAR_WIDGET_ID = "a473169ad4d64e4f88ee8ad0d1668898";
