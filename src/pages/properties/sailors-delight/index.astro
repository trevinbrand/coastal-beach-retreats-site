---
/**
 * FILE: src/pages/properties/sailors-delight/index.astro
 * UPDATED FOR FASTER PHOTO LOADING:
 * - Uses .webp for all images
 * - Preloads the first hero image
 * - Uses fetchpriority="high" on the first/top image
 * - Keeps mobile slider and desktop collage layout
 * - OwnerRez widget still loads once at the bottom
 */
import "../../../styles/global.css";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

// ✅ Photo setup (RS1.webp ... RS47.webp)
const PHOTO_COUNT = 47;

// ✅ Update this folder if needed
const PHOTO_BASE = "/images/props/sailors";

// ✅ Where the separate photos page lives:
const PHOTOS_PAGE_HREF = "/properties/sailors-delight/photos/";

// ✅ Precompute strings used in attributes
const photosCountAria = `${PHOTO_COUNT} photos`;

// Build full list
const galleryPhotos = Array.from({ length: PHOTO_COUNT }, (_, i) => {
  const n = i + 1;
  return {
    src: `${PHOTO_BASE}/RS${n}.webp`,
    alt: `Sailor's Delight Edgewater Tower 1-911 Panama City Beach condo photo ${n}`,
  };
});

// Collage uses first 5
const photosTop = galleryPhotos.slice(0, 5);

const pageTitle =
  "Sailor's Delight @ Edgewater Tower 1-911 | Panama City Beach Condo Rental";
const subtitle =
  "Ninth-floor Edgewater condo with Gulf views, resort amenities, and sleeping for up to 9.";

// These show ABOVE the description
const sizeLine = "2 Bedrooms • 2 Bathrooms • Sleeps 1-9";
const amenitiesLine = ["Internet", "Oceanfront", "Hot Tub"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle} | Coastal Beach Retreats</title>
    <meta
      name="description"
      content="Sailor's Delight at Edgewater Tower 1-911 is a ninth-floor Panama City Beach condo with Gulf and lagoon views, beach gear, full resort amenities, walkable dining, and parking for up to two vehicles included."
    />

    <!-- ✅ Preload first/top hero image -->
    <link rel="preload" as="image" href={photosTop[0].src} />
    <link rel="icon" href="/images/logo.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/logo.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
  </head>

  <body>
    <SiteHeader phone="(918) 734-3331" />

    <main class="wrap">
      <header class="titlebar">
        <h1 class="h1">{pageTitle}</h1>
        <p class="sub">{subtitle}</p>
      </header>

      <!-- PHOTO COLLAGE (desktop/tablet) + MOBILE HERO SLIDER (1 photo with arrows) -->
      <section class="collage" id="photos" aria-label="Photo preview">
        <!-- BIG LEFT (always visible; becomes the ONLY photo on mobile) -->
        <a class="big" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
          <img
            id="heroImg"
            src={photosTop[0].src}
            alt={photosTop[0].alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="1600"
            height="900"
          />

          <!-- ✅ Mobile arrows (only visible on mobile) -->
          <button
            class="arrow left"
            type="button"
            aria-label="Previous photo"
            data-arrow="prev"
          >
            ‹
          </button>
          <button
            class="arrow right"
            type="button"
            aria-label="Next photo"
            data-arrow="next"
          >
            ›
          </button>

          <!-- ✅ Mobile camera badge (bottom-right) -->
          <span class="mobileCam" aria-label={photosCountAria}>
            <span class="cam" aria-hidden="true">📷</span>
            {PHOTO_COUNT}
          </span>
        </a>

        <!-- RIGHT GRID (hidden on mobile) -->
        <div class="smallGrid" aria-hidden="true">
          <a class="small" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
            <img
              src={photosTop[1].src}
              alt={photosTop[1].alt}
              loading="lazy"
              decoding="async"
              width="800"
              height="600"
            />
          </a>

          <a class="small" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
            <img
              src={photosTop[2].src}
              alt={photosTop[2].alt}
              loading="lazy"
              decoding="async"
              width="800"
              height="600"
            />
          </a>

          <a class="small" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
            <img
              src={photosTop[3].src}
              alt={photosTop[3].alt}
              loading="lazy"
              decoding="async"
              width="800"
              height="600"
            />
          </a>

          <!-- LAST TILE WITH PHOTO COUNT BADGE -->
          <a class="small last" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
            <img
              src={photosTop[4].src}
              alt={photosTop[4].alt}
              loading="lazy"
              decoding="async"
              width="800"
              height="600"
            />
            <span class="countBadge" aria-label={photosCountAria}>
              <span class="cam" aria-hidden="true">📷</span>
              {PHOTO_COUNT}
            </span>
          </a>
        </div>
      </section>

      <!-- SECTION NAV ROW -->
      <nav class="subnav" aria-label="Page sections">
        <a href={PHOTOS_PAGE_HREF}>PHOTOS</a>
        <a href="#details">DETAILS</a>
        <a href="#availability">AVAILABILITY</a>
        <a href="#location">LOCATION</a>
        <a href="#amenities">AMENITIES</a>
        <a href="#reviews">REVIEWS</a>
      </nav>

      <!-- DETAILS + BOOKING WIDGET -->
      <section class="below" id="details" aria-label="Details and booking">
        <!-- LEFT -->
        <div class="desc">
          <div class="metaLine">
            <span class="metaLabel">Size –</span>
            <span>{sizeLine}</span>
          </div>

          <div class="metaLine">
            <span class="metaLabel">Amenities –</span>
            <span class="amenInline">
              {amenitiesLine.map((a, i) => (
                <span class="amenItem">
                  <span class="chip">{a}</span>
                  {i < amenitiesLine.length - 1 ? <span class="dot">•</span> : null}
                </span>
              ))}
              <a class="more" href="#amenities">(more...)</a>
            </span>
          </div>

          <!-- ✅ UPDATED DESCRIPTION -->
          <div class="longDesc">
            <p>
              Coastal Beach Retreats welcomes you to this beautifully remodeled <strong>ninth-floor, deluxe 2-bedroom condo</strong>
              offering <strong>1,366 square feet</strong> of open living space in Tower 1 at
              <strong>Edgewater Beach &amp; Golf Resort</strong>. Completely remodeled with crisp nautical navy and white décor,
              this spacious retreat features an open layout that is perfect for families or close friends vacationing together.
            </p>

            <p>
              <strong>The nightly rate includes parking for up to two vehicles during your stay.</strong>
            </p>

            <p><strong>🏖️ Spacious living with beautiful views</strong></p>

            <p>
              Enjoy stunning views of the lagoon pool, 110 acres of beachfront resort grounds, and the Gulf of Mexico from the
              living room and kitchen areas. The living space offers comfortable seating and a large flat-screen TV with cable,
              creating the perfect place to relax after a day at the beach.
            </p>

            <p>
              The fully equipped kitchen features granite countertops, all-new stainless steel appliances, and everything needed
              to prepare meals or beach-day snacks. An island provides seating for two, while the adjacent dining table
              comfortably seats six.
            </p>

            <p>
              Beach days are easy with provided beach gear, including six beach chairs, a beach umbrella, eight beach towels,
              and a Tommy Bahama shoulder cooler.
            </p>

            <p>
              Step outside through the sliding glass doors to your private balcony, where you can enjoy coastal breezes and salty Gulf air.
            </p>

            <p><strong>🛏️ Comfortable sleeping accommodations</strong></p>

            <p>
              The primary bedroom features a king bed, flat-screen TV, and a fully remodeled ensuite bathroom. The guest bedroom
              includes a queen bed and flat-screen TV. Twin-over-full bunk beds are tucked into a hallway nook, and each bunk
              features its own smart TV at the base, giving kids (or adults!) their own cozy entertainment space. The living area
              includes a gel-foam queen sleeper sofa to accommodate additional guests.
            </p>

            <p>
              An in-unit washer and dryer make it easy to refresh swimsuits and clothing during your stay. High-speed WiFi is
              available throughout the condo.
            </p>

            <p>
              The nautical décor and shiplap accents create a clean, fresh, beachfront feel, making this unit one of the most
              attractive condos at the resort.
            </p>

            <p><strong>🌴 Edgewater Beach &amp; Golf Resort amenities</strong></p>

            <p>
              Edgewater Beach &amp; Golf Resort is Panama City Beach’s only full-service resort, offering exceptional amenities
              for guests of all ages. Beachside amenities include a full-service restaurant, tiki bar, massive oceanside lagoon pool,
              kids’ splash area, Starbucks, market, ice cream parlor, four hot tubs, water sports and activities, and beach chair
              service at both the pool and beach.
            </p>

            <p>
              Across the pedestrian bridge, guests enjoy access to a 9-hole golf course and pro shop. Additional complimentary
              amenities include a fitness center, basketball court, eleven pools with ten seasonally heated, ten plexicushion
              tennis courts, shuffleboard courts, and pickleball courts.
            </p>

            <p><strong>📍 Walkable dining &amp; prime PCB location</strong></p>

            <p>
              Just outside the resort’s 24/7 manned security gates, guests will find a wide variety of walkable dining options
              ranging from New York–style pizza and casual cafés to high-end seafood, Cajun cuisine, Mexican restaurants, Subway,
              and Waffle House. The central location makes it easy to explore everything Panama City Beach has to offer.
            </p>

            <p><strong>ℹ️ Important guest information</strong></p>

            <p>
              The primary renter must be at least 25 years old, sign a rental agreement within 48 hours of booking, and be present
              for the duration of the stay. A $200 damage hold is required on a debit or credit card in the renter’s name.
              Smoking and parties are not permitted.
            </p>

            <p>
              The booking includes the resort fee and parking for up to two vehicles. This property is equipped with a
              Ring peephole camera on the front door that records activity outside the entrance only. Starter
              supplies of soaps and paper products are provided. Guests should plan to purchase additional supplies for longer stays.
            </p>

            <p><strong>⭐ Why book this Edgewater Tower 1 condo</strong></p>

            <p>
              This ninth-floor deluxe condo at Edgewater Beach &amp; Golf Resort offers beautiful views, modern coastal décor,
              generous sleeping accommodations (including TVs in the bunk beds for added comfort and entertainment), and full
              access to resort-style amenities, making it an ideal choice for families and guests seeking a premium beachfront
              vacation in Panama City Beach.
            </p>
          </div>
        </div>

        <!-- RIGHT: booking widget -->
        <aside class="book">
          <div class="bookInner">
            <div
              class="ownerrez-widget"
              data-propertyId="b5d18ffff9c74f87a0ee5f93d90df879"
              data-widget-type="Booking/Inquiry"
              data-widgetId="90e56b8a4a654b05adf999a2230671fb"
            ></div>
          </div>
        </aside>
      </section>

      <!-- LOCATION -->
      <section id="location" class="card">
        <h2 class="h2">Location</h2>
        <p>
          Edgewater Beach &amp; Golf Resort • Tower 1 • Panama City Beach, FL<br />
          11483 Front Beach Rd, T1-911 Panama City Beach, FL 32407
        </p>

        <div class="mapWrap" aria-label="Map">
          <iframe
            title="Map: Sailor's Delight location"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            src="https://www.google.com/maps?q=30.18528,-85.82094&z=17&output=embed"
          ></iframe>

          <a
            class="mapLink"
            href="https://www.google.com/maps/search/?api=1&query=Edgewater%20Beach%20%26%20Golf%20Resort%20Panama%20City%20Beach%20FL"
            target="_blank"
            rel="noopener"
          >
            View on Google Maps →
          </a>
        </div>
      </section>

      <!-- AMENITIES -->
      <section id="amenities" class="card">
        <h2 class="h2">Amenities</h2>

        <div class="amenities-table">
          <div class="amen-row">
            <div class="amen-label">Property Type</div>
            <div class="amen-value">Condo</div>
          </div>

          <div class="amen-row">
            <div class="amen-label">Resort</div>
            <div class="amen-value">Edgewater Beach &amp; Golf Resort</div>
          </div>

          <div class="amen-row">
            <div class="amen-label">General</div>
            <div class="amen-value columns">
              <span>Internet / WiFi</span>
              <span>Air Conditioning</span>
              <span>Linens &amp; Towels</span>
              <span>Washer/Dryer</span>
            </div>
          </div>

          <div class="amen-row">
            <div class="amen-label">Kitchen</div>
            <div class="amen-value columns">
              <span>Refrigerator</span>
              <span>Oven/Stove</span>
              <span>Microwave</span>
              <span>Dishwasher</span>
            </div>
          </div>

          <div class="amen-row">
            <div class="amen-label">Pool &amp; Spa</div>
            <div class="amen-value columns">
              <span>Lagoon Pool</span>
              <span>Hot Tubs</span>
              <span>Kids Splash Area</span>
            </div>
          </div>

          <div class="amen-row">
            <div class="amen-label">Outdoor</div>
            <div class="amen-value columns">
              <span>Beach Access</span>
              <span>Balcony</span>
              <span>Beach Chair Service (seasonal)</span>
            </div>
          </div>
        </div>
      </section>

      <!-- REVIEWS -->
      <section id="reviews" class="card">
        <h2 class="h2">Reviews</h2>

        <div
          class="ownerrez-widget"
          data-widget-type="Reviews - Reviews"
          data-widgetId="e5c9806cc0db4404abe98eb6b90868a2"
          data-propertyId="b5d18ffff9c74f87a0ee5f93d90df879"
        ></div>
      </section>

      <!-- AVAILABILITY -->
      <section id="availability" class="card">
        <h2 class="h2">Availability</h2>

        <div
          class="ownerrez-widget"
          data-widgetId="1238054a534b4c4baeeb315d647ec74e"
          data-propertyId="b5d18ffff9c74f87a0ee5f93d90df879"
          data-widget-type="Multiple Month Calendar"
        ></div>
      </section>
    </main>

    <SiteFooter phone="(918) 734-3331" email="coastalbeachretreats@gmail.com" />

    <!-- ✅ Load OwnerRez widget script ONCE (avoid duplicates) -->
    <script is:inline src="https://app.ownerrez.com/widget.js"></script>

    <!-- ✅ Mobile hero slider script (runs only on small screens) -->
    <script is:inline define:vars={{ galleryPhotos }}>
      (function () {
        const isMobile = window.matchMedia("(max-width: 640px)").matches;
        if (!isMobile) return;

        const photos = JSON.parse(JSON.stringify(galleryPhotos || []));
        if (!photos.length) return;

        const heroImg = document.getElementById("heroImg");
        const bigLink = heroImg?.closest("a.big");
        if (!heroImg || !bigLink) return;

        let idx = 0;

        function setPhoto(i) {
          idx = (i + photos.length) % photos.length;
          heroImg.src = photos[idx].src;
          heroImg.alt = photos[idx].alt;
        }

        function onArrow(e, dir) {
          e.preventDefault();
          e.stopPropagation();
          setPhoto(idx + (dir === "next" ? 1 : -1));
        }

        const prevBtn = bigLink.querySelector('button[data-arrow="prev"]');
        const nextBtn = bigLink.querySelector('button[data-arrow="next"]');

        prevBtn?.addEventListener("click", (e) => onArrow(e, "prev"));
        nextBtn?.addEventListener("click", (e) => onArrow(e, "next"));

        // Optional swipe
        let startX = 0;
        heroImg.addEventListener(
          "touchstart",
          (e) => {
            startX = e.touches?.[0]?.clientX || 0;
          },
          { passive: true }
        );
        heroImg.addEventListener(
          "touchend",
          (e) => {
            const endX = e.changedTouches?.[0]?.clientX || 0;
            const dx = endX - startX;
            if (Math.abs(dx) < 40) return;
            setPhoto(idx + (dx < 0 ? 1 : -1));
          },
          { passive: true }
        );

        setPhoto(0);
      })();
    </script>

    <style>
      .wrap {
        max-width: 1440px;
        margin: 0 auto;
        padding: 12px 10px;
      }

      .titlebar { margin: 10px 0 14px; }
      .h1 {
        margin: 0 0 6px;
        font-size: 34px;
        line-height: 1.1;
        color: var(--brand-blue, #193e7f);
      }
      .sub { margin: 0; opacity: .85; }

      /* Collage */
      .collage {
        display: grid;
        grid-template-columns: 1.55fr 1fr;
        gap: 2px;
        margin: 14px 0 12px;
      }

      .big, .small {
        display: block;
        border-radius: 0;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,.12);
        background: rgba(0,0,0,.04);
        text-decoration: none;
        position: relative;
      }

      .big img {
        width: 100%;
        height: 420px;
        object-fit: cover;
        display: block;
      }

      .smallGrid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2px;
      }

      .small img {
        width: 100%;
        height: 205px;
        object-fit: cover;
        display: block;
      }

      /* Desktop/tablet badge (last tile) */
      .countBadge {
        position: absolute;
        right: 10px;
        bottom: 10px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        border-radius: 12px;
        background: rgba(0,0,0,.55);
        color: #fff;
        font-weight: 800;
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(6px);
      }

      /* ✅ Mobile camera badge */
      .mobileCam {
        position: absolute;
        right: 10px;
        bottom: 10px;
        display: none;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        border-radius: 999px;
        background: rgba(0,0,0,.60);
        color: #fff;
        font-weight: 900;
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(6px);
        pointer-events: none;
      }

      .cam { font-size: 16px; }

      /* ✅ Mobile arrows (hidden by default) */
      .arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 40px;
        height: 40px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.22);
        background: rgba(0,0,0,.45);
        color: #fff;
        font-size: 28px;
        line-height: 1;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }
      .arrow.left { left: 10px; }
      .arrow.right { right: 10px; }
      .arrow:active { transform: translateY(-50%) scale(0.98); }

      /* subnav row */
      .subnav {
        display: flex;
        gap: 22px;
        align-items: center;
        padding: 14px 4px 8px;
        border-bottom: 1px solid rgba(0,0,0,.10);
        margin-bottom: 14px;
        flex-wrap: wrap;
      }
      .subnav a {
        text-decoration: none;
        font-weight: 800;
        letter-spacing: .08em;
        font-size: 14px;
        color: rgba(25,62,127,.75);
      }
      .subnav a:hover { color: var(--brand-blue, #193e7f); }

      /* description + widget area */
      .below {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 22px;
        align-items: start;
        margin: 8px 0 18px;
      }

      .desc { padding-right: 6px; }

      .metaLine {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin: 10px 0;
        font-size: 20px;
        line-height: 1.25;
      }

      .metaLabel {
        font-family: var(--font-heading, "Dancing Script", cursive);
        color: var(--accent-teal, #058789);
        font-weight: 700;
        font-size: 24px;
        white-space: nowrap;
      }

      .amenInline {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .amenItem {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }

      .chip { font-weight: 600; }
      .dot { opacity: .55; }

      .more {
        text-decoration: none;
        font-weight: 700;
        color: rgba(25,62,127,.75);
      }
      .more:hover { color: var(--brand-blue, #193e7f); }

      .longDesc p {
        font-size: 16px;
        line-height: 1.75;
        margin: 14px 0;
      }

      .bookInner {
        position: sticky;
        top: 92px;
        border: 1px solid rgba(0,0,0,.12);
        border-radius: 16px;
        padding: 14px;
        background: #fff;
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
      }

      /* section cards */
      .card {
        border: 1px solid rgba(0,0,0,.12);
        border-radius: 16px;
        padding: 14px;
        background: #fff;
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
        margin-bottom: 14px;
      }

      .h2 {
        margin: 0 0 10px;
        font-size: 24px;
        color: var(--brand-blue, #193e7f);
      }

      /* map */
      .mapWrap {
        margin-top: 12px;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,.12);
        background: #fff;
      }
      .mapWrap iframe {
        width: 100%;
        height: 360px;
        border: 0;
        display: block;
      }
      .mapLink {
        display: block;
        padding: 10px 12px;
        text-align: right;
        font-weight: 800;
        text-decoration: none;
        color: rgba(25,62,127,.85);
      }
      .mapLink:hover { color: var(--brand-blue, #193e7f); }

      /* amenities table */
      .amenities-table {
        margin-top: 8px;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,.10);
        background: #fff;
      }

      .amen-row {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 18px;
        padding: 18px 18px;
        border-top: 1px solid rgba(0,0,0,.08);
      }
      .amen-row:first-child { border-top: 0; }

      .amen-label { font-weight: 800; color: #111; }
      .amen-value { color: #111; }

      .amen-value.columns {
        display: grid;
        grid-template-columns: repeat(4, minmax(180px, 1fr));
        gap: 8px 18px;
      }

      .amen-value.columns span {
        display: block;
        white-space: normal;
      }

      @media (max-width: 980px) {
        .wrap { padding: 12px 12px; }
        .collage { grid-template-columns: 1fr; }
        .big img { height: 320px; }
        .small img { height: 160px; }
        .below { grid-template-columns: 1fr; }
        .bookInner { position: static; }
        .mapWrap iframe { height: 300px; }

        .amen-row { grid-template-columns: 1fr; }
        .amen-value.columns { grid-template-columns: repeat(2, minmax(160px, 1fr)); }
      }

      /* ✅ Mobile behavior + ✅ move booking widget above description (mobile only) */
      @media (max-width: 640px) {
        .smallGrid { display: none; }
        .mobileCam { display: inline-flex; }
        .arrow { display: inline-flex; }
        .big img { height: 320px; }

        /* ✅ Reorder: booking widget first, then description */
        .below { display: grid; grid-template-columns: 1fr; }
        .below .book { order: 1; }
        .below .desc { order: 2; }

        /* ✅ Make it look natural on mobile */
        .bookInner { position: static; margin-bottom: 12px; }
      }

      @media (max-width: 520px) {
        .amen-value.columns { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>