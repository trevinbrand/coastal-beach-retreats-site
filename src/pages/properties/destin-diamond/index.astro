---
/**
 * FILE: src/pages/properties/destin-diamond/index.astro
 * - Mobile shows ONE hero image with arrows to cycle through ALL photos
 * - Camera badge shows photo count (tap image goes to /photos/)
 * - Desktop/tablet keeps the 5-photo collage
 * - On mobile ONLY, booking widget moves ABOVE the description
 *
 * NOTE: widget.js is loaded ONCE at the bottom.
 */
import "../../../styles/global.css";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

/** ✅ TODO: update these 3 things */
const PHOTO_COUNT = 30; // <-- TODO: set your real count
const PHOTO_BASE = "/images/props/destin-diamond"; // <-- TODO: create this folder in /public
const PHOTOS_PAGE_HREF = "/properties/destin-diamond/photos/";

/** ✅ Precompute strings used in attributes */
const photosCountAria = `${PHOTO_COUNT} photos`;

/** ✅ TODO: choose your naming convention */
const galleryPhotos = Array.from({ length: PHOTO_COUNT }, (_, i) => {
  const n = i + 1;
  return {
    // OPTION A: DD1.jpeg, DD2.jpeg...
    src: `${PHOTO_BASE}/DD${n}.jpeg`,
    // OPTION B: d1.jpeg, d2.jpeg...
    // src: `${PHOTO_BASE}/d${n}.jpeg`,
    alt: `Destin Diamond photo ${n}`,
  };
});

const photosTop = galleryPhotos.slice(0, 5);

/** ✅ TODO: update text */
const pageTitle = "Destin Diamond • Destin, FL"; // TODO
const subtitle = "Your subtitle goes here."; // TODO
const sizeLine = "X Bedrooms • X Bathrooms • Sleeps X"; // TODO
const amenitiesLine = ["Internet", "Something", "Something"]; // TODO

/** ✅ TODO: OwnerRez IDs (replace with your real ones) */
const OR_PROPERTY_ID = "REPLACE_ME";
const OR_BOOKING_WIDGET_ID = "REPLACE_ME";
const OR_REVIEWS_WIDGET_ID = "REPLACE_ME";
const OR_CALENDAR_WIDGET_ID = "REPLACE_ME";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle} | Coastal Beach Retreats</title>
    <meta
      name="description"
      content="Destin Diamond — photos, details, and booking."
    />
  </head>

  <body>
    <SiteHeader phone="(918) 734-3331" />

    <main class="wrap">
      <header class="titlebar">
        <h1 class="h1">{pageTitle}</h1>
        <p class="sub">{subtitle}</p>
      </header>

      <!-- PHOTO COLLAGE + MOBILE HERO SLIDER -->
      <section class="collage" id="photos" aria-label="Photo preview">
        <a class="big" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
          <img id="heroImg" src={photosTop[0].src} alt={photosTop[0].alt} loading="eager" />

          <button class="arrow left" type="button" aria-label="Previous photo" data-arrow="prev">‹</button>
          <button class="arrow right" type="button" aria-label="Next photo" data-arrow="next">›</button>

          <span class="mobileCam" aria-label={photosCountAria}>
            <span class="cam" aria-hidden="true">📷</span>
            {PHOTO_COUNT}
          </span>
        </a>

        <div class="smallGrid" aria-hidden="true">
          <a class="small" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
            <img src={photosTop[1].src} alt={photosTop[1].alt} loading="lazy" />
          </a>
          <a class="small" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
            <img src={photosTop[2].src} alt={photosTop[2].alt} loading="lazy" />
          </a>
          <a class="small" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
            <img src={photosTop[3].src} alt={photosTop[3].alt} loading="lazy" />
          </a>
          <a class="small last" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
            <img src={photosTop[4].src} alt={photosTop[4].alt} loading="lazy" />
            <span class="countBadge" aria-label={photosCountAria}>
              <span class="cam" aria-hidden="true">📷</span>
              {PHOTO_COUNT}
            </span>
          </a>
        </div>
      </section>

      <nav class="subnav" aria-label="Page sections">
        <a href={PHOTOS_PAGE_HREF}>PHOTOS</a>
        <a href="#details">DETAILS</a>
        <a href="#availability">AVAILABILITY</a>
        <a href="#location">LOCATION</a>
        <a href="#amenities">AMENITIES</a>
        <a href="#reviews">REVIEWS</a>
      </nav>

      <section class="below" id="details" aria-label="Details and booking">
        <div class="desc">
          <div class="metaLine">
            <span class="metaLabel">Size –</span>
            <span>{sizeLine}</span>
          </div>

          <div class="metaLine">
            <span class="metaLabel">Amenities –</span>
            <span class="amenInline">
              {amenitiesLine.map((a, i) => (
                <span class="amenItem">
                  <span class="chip">{a}</span>
                  {i < amenitiesLine.length - 1 ? <span class="dot">•</span> : null}
                </span>
              ))}
              <a class="more" href="#amenities">(more...)</a>
            </span>
          </div>

          <div class="longDesc">
            <!-- ✅ TODO: replace with Destin Diamond description -->
            <p><strong>Destin Diamond</strong> description goes here.</p>
          </div>
        </div>

        <aside class="book">
          <div class="bookInner">
            <div
              class="ownerrez-widget"
              data-propertyId={OR_PROPERTY_ID}
              data-widget-type="Booking/Inquiry"
              data-widgetId={OR_BOOKING_WIDGET_ID}
            ></div>
          </div>
        </aside>
      </section>

      <section id="location" class="card">
        <h2 class="h2">Location</h2>
        <!-- ✅ TODO: update address + map -->
        <p>Destin, FL</p>
      </section>

      <section id="amenities" class="card">
        <h2 class="h2">Amenities</h2>
        <!-- ✅ TODO: add your amenities table or copy one from another page -->
        <p>Coming soon.</p>
      </section>

      <section id="reviews" class="card">
        <h2 class="h2">Reviews</h2>
        <div
          class="ownerrez-widget"
          data-propertyId={OR_PROPERTY_ID}
          data-widget-type="Reviews"
          data-widgetId={OR_REVIEWS_WIDGET_ID}
        ></div>
      </section>

      <section id="availability" class="card">
        <h2 class="h2">Availability</h2>
        <div
          class="ownerrez-widget"
          data-propertyId={OR_PROPERTY_ID}
          data-widget-type="Multiple Month Calendar"
          data-widgetId={OR_CALENDAR_WIDGET_ID}
        ></div>
      </section>
    </main>

    <SiteFooter phone="(918) 734-3331" email="coastalbeachretreats@gmail.com" />

    <script is:inline src="https://app.ownerrez.com/widget.js"></script>

    <script is:inline define:vars={{ galleryPhotos }}>
      (function () {
        const isMobile = window.matchMedia("(max-width: 640px)").matches;
        if (!isMobile) return;

        const photos = JSON.parse(JSON.stringify(galleryPhotos || []));
        if (!photos.length) return;

        const heroImg = document.getElementById("heroImg");
        const bigLink = heroImg?.closest("a.big");
        if (!heroImg || !bigLink) return;

        let idx = 0;

        function setPhoto(i) {
          idx = (i + photos.length) % photos.length;
          heroImg.src = photos[idx].src;
          heroImg.alt = photos[idx].alt;
        }

        function onArrow(e, dir) {
          e.preventDefault();
          e.stopPropagation();
          setPhoto(idx + (dir === "next" ? 1 : -1));
        }

        const prevBtn = bigLink.querySelector('button[data-arrow="prev"]');
        const nextBtn = bigLink.querySelector('button[data-arrow="next"]');

        prevBtn?.addEventListener("click", (e) => onArrow(e, "prev"));
        nextBtn?.addEventListener("click", (e) => onArrow(e, "next"));

        let startX = 0;
        heroImg.addEventListener("touchstart", (e) => {
          startX = e.touches?.[0]?.clientX || 0;
        }, { passive: true });

        heroImg.addEventListener("touchend", (e) => {
          const endX = e.changedTouches?.[0]?.clientX || 0;
          const dx = endX - startX;
          if (Math.abs(dx) < 40) return;
          setPhoto(idx + (dx < 0 ? 1 : -1));
        }, { passive: true });

        setPhoto(0);
      })();
    </script>

    <style>
      .wrap { max-width: 1440px; margin: 0 auto; padding: 12px 10px; }
      .titlebar { margin: 10px 0 14px; }
      .h1 { margin: 0 0 6px; font-size: 34px; line-height: 1.1; color: var(--brand-blue, #193e7f); }
      .sub { margin: 0; opacity: .85; }

      .collage { display: grid; grid-template-columns: 1.55fr 1fr; gap: 2px; margin: 14px 0 12px; }
      .big, .small { display: block; border-radius: 0; overflow: hidden; border: 1px solid rgba(0,0,0,.12); background: rgba(0,0,0,.04); text-decoration: none; position: relative; }
      .big img { width: 100%; height: 420px; object-fit: cover; display: block; }

      .smallGrid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
      .small img { width: 100%; height: 205px; object-fit: cover; display: block; }

      .countBadge {
        position: absolute; right: 10px; bottom: 10px;
        display: inline-flex; align-items: center; gap: 8px;
        padding: 8px 10px; border-radius: 12px;
        background: rgba(0,0,0,.55); color: #fff; font-weight: 800;
        border: 1px solid rgba(255,255,255,.18); backdrop-filter: blur(6px);
      }

      .mobileCam {
        position: absolute; right: 10px; bottom: 10px;
        display: none; align-items: center; gap: 8px;
        padding: 10px 12px; border-radius: 999px;
        background: rgba(0,0,0,.60); color: #fff; font-weight: 900;
        border: 1px solid rgba(255,255,255,.18); backdrop-filter: blur(6px);
        pointer-events: none;
      }
      .cam { font-size: 16px; }

      .arrow {
        position: absolute; top: 50%; transform: translateY(-50%);
        width: 40px; height: 40px; border-radius: 999px;
        border: 1px solid rgba(255,255,255,.22);
        background: rgba(0,0,0,.45); color: #fff;
        font-size: 28px; line-height: 1;
        display: none; align-items: center; justify-content: center;
        cursor: pointer; -webkit-tap-highlight-color: transparent;
      }
      .arrow.left { left: 10px; }
      .arrow.right { right: 10px; }
      .arrow:active { transform: translateY(-50%) scale(0.98); }

      .subnav {
        display: flex; gap: 22px; align-items: center;
        padding: 14px 4px 8px; border-bottom: 1px solid rgba(0,0,0,.10);
        margin-bottom: 14px; flex-wrap: wrap;
      }
      .subnav a {
        text-decoration: none; font-weight: 800; letter-spacing: .08em;
        font-size: 14px; color: rgba(25,62,127,.75);
      }
      .subnav a:hover { color: var(--brand-blue, #193e7f); }

      .below { display: grid; grid-template-columns: 1.6fr 1fr; gap: 22px; align-items: start; margin: 8px 0 18px; }
      .desc { padding-right: 6px; }

      .metaLine { display: flex; align-items: baseline; gap: 10px; margin: 10px 0; font-size: 20px; line-height: 1.25; }
      .metaLabel { font-family: var(--font-heading, "Dancing Script", cursive); color: var(--accent-teal, #058789); font-weight: 700; font-size: 24px; white-space: nowrap; }

      .amenInline { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; }
      .amenItem { display: inline-flex; align-items: center; gap: 10px; }
      .chip { font-weight: 600; }
      .dot { opacity: .55; }

      .more { text-decoration: none; font-weight: 700; color: rgba(25,62,127,.75); }
      .more:hover { color: var(--brand-blue, #193e7f); }

      .longDesc p { font-size: 16px; line-height: 1.75; margin: 14px 0; }

      .bookInner {
        position: sticky; top: 92px;
        border: 1px solid rgba(0,0,0,.12); border-radius: 16px;
        padding: 14px; background: #fff; box-shadow: 0 6px 18px rgba(0,0,0,.06);
      }

      .card {
        border: 1px solid rgba(0,0,0,.12); border-radius: 16px;
        padding: 14px; background: #fff;
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
        margin-bottom: 14px;
      }
      .h2 { margin: 0 0 10px; font-size: 24px; color: var(--brand-blue, #193e7f); }

      @media (max-width: 980px) {
        .wrap { padding: 12px 12px; }
        .collage { grid-template-columns: 1fr; }
        .big img { height: 320px; }
        .small img { height: 160px; }
        .below { grid-template-columns: 1fr; }
        .bookInner { position: static; }
      }

      @media (max-width: 640px) {
        .smallGrid { display: none; }
        .mobileCam { display: inline-flex; }
        .arrow { display: inline-flex; }
        .big img { height: 320px; }

        /* ✅ booking widget above description (mobile only) */
        .below { display: grid; grid-template-columns: 1fr; }
        .below .book { order: 1; }
        .below .desc { order: 2; }
        .bookInner { position: static; margin-bottom: 12px; }
      }
    </style>
  </body>
</html>
