const PHOTO_BASE = "/images/props/destin-diamond";
const PHOTOS_PAGE_HREF = "/properties/destin-diamond/photos/";

/** ✅ Precompute strings used in attributes */
const photosCountAria = `${PHOTO_COUNT} photos`;

/** ✅ Uses thumb-dd1.webp ... thumb-dd33.webp for page previews */
const galleryPhotos = Array.from({ length: PHOTO_COUNT }, (_, i) => {
  const n = i + 1;
  return {
    src: `${PHOTO_BASE}/thumb-dd${n}.webp`,
    full: `${PHOTO_BASE}/dd${n}.webp`,
    alt: `Destin Diamond photo ${n}`,
  };
});

// Collage uses first 5
const photosTop = galleryPhotos.slice(0, 5);

/** ✅ Update text */
const pageTitle = "Destin Diamond • Destin, FL";
const subtitle = "Destin Diamond 🌊 Beachfront Condo at Sterling Sands in Destin, Florida Unit 111";
const sizeLine = "2 Bedrooms • 2 Bathrooms • Sleeps 1-4";
const amenitiesLine = ["Internet", "Oceanfront", "Hot Tub"];

/** ✅ OwnerRez IDs (replace with your real ones) */
const OR_PROPERTY_ID = "d4f06489762941e6ae16e3cc23edbec2";
const OR_BOOKING_WIDGET_ID = "e1923f2eaa344430a02d0dfd6835a4fd";
const OR_REVIEWS_WIDGET_ID = "c92c43f6983e41c6a05dfda2bea6985c";
const OR_CALENDAR_WIDGET_ID = "733bba48b6304b9bb9e95adc2394298a";
