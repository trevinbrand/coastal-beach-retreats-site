---
/**
 * FILE: src/pages/properties/fanta-sea/index.astro
 * - Mobile shows ONE hero image with arrows to cycle through ALL photos (fs1..fs34)
 * - Camera badge shows photo count (tap image goes to /photos/)
 * - Desktop/tablet keeps the 5-photo collage (first 5 photos)
 * - On mobile ONLY, booking widget moves ABOVE the description
 *
 * NOTE: widget.js is loaded ONCE at the bottom.
 */
import "../../../styles/global.css";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

// ✅ Photos: fs1.webp ... fs34.webp in /public/images/props/fanta-sea/
const PHOTO_COUNT = 34;
const PHOTO_BASE = "/images/props/fanta-sea";
const PHOTOS_PAGE_HREF = "/properties/fanta-sea/photos/";

// ✅ Precompute strings used in attributes
const photosCountAria = `${PHOTO_COUNT} photos`;

// ✅ Build gallery list (used for collage + mobile slider)
const galleryPhotos = Array.from({ length: PHOTO_COUNT }, (_, i) => {
  const n = i + 1;
  return {
    src: `${PHOTO_BASE}/fs${n}.webp`,
    alt: `Fanta Sea Waterscape Resort Okaloosa Island condo photo ${n}`,
  };
});

// ✅ Collage uses first 5 (same path)
const photosTop = galleryPhotos.slice(0, 5);

// ✅ Page text
const pageTitle = "Fanta Sea at Waterscape Resort | Okaloosa Island Condo Rental";
const subtitle = "Family-friendly Waterscape Resort condo with pool views, beach access, and sleeps 6.";
const sizeLine = "1 Bedroom + Bunk nook • 2 Bathrooms • Sleeps 6";
const amenitiesLine = ["Internet", "Resort Pools", "Beach Access"];

// ✅ OwnerRez IDs (your real ones)
const OR_PROPERTY_ID = "c0b8169048144706b444df259a6db68d";
const OR_BOOKING_WIDGET_ID = "554188faec574f7bb85d3c805ec98845";
const OR_REVIEWS_WIDGET_ID = "5ee9e6bc937841e98af4a9a54eadf3c3";
const OR_CALENDAR_WIDGET_ID = "4c14755058f04893a35ffd79fc0ebf19";
---

