---
/**
 * FILE: src/pages/properties/fanta-sea/index.astro
 * - Mobile shows ONE hero image with arrows to cycle through ALL photos
 * - Camera badge shows photo count (tap image goes to /photos/)
 * - Desktop/tablet keeps the 5-photo collage (first 5 photos)
 * - On mobile ONLY, booking widget moves ABOVE the description
 *
 * NOTE: widget.js is loaded ONCE at the bottom.
 */
import "../../../styles/global.css";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

// ✅ Photos: fs1.jpg ... fs34.jpg in /public/images/props/fanta-sea/
const PHOTO_COUNT = 34;
const PHOTO_BASE = "/images/props/fanta-sea";
const PHOTOS_PAGE_HREF = "/properties/fanta-sea/photos/";

// ✅ Precompute strings used in attributes
const photosCountAria = `${PHOTO_COUNT} photos`;

// ✅ Build gallery list (used for collage + mobile slider)
const galleryPhotos = Array.from({ length: PHOTO_COUNT }, (_, i) => {
  const n = i + 1;
  return {
    src: `${PHOTO_BASE}/fs${n}.jpg`,
    alt: `Fanta Sea photo ${n}`,
  };
});

// ✅ Collage uses first 5 (same path)
const photosTop = galleryPhotos.slice(0, 5);

// ✅ Updated text
const pageTitle = "🌊 Welcome to Fanta Sea at Waterscape Resort | A328";
const subtitle = "Beachy, bright, and steps from the fun — your Waterscape escape.";
const sizeLine = "1 Bedroom + Bunk nook • 2 Bathrooms • Sleeps 6";
const amenitiesLine = ["Internet", "Resort Pools", "Beach Access"];

// ✅ OwnerRez IDs (replace with your real ones)
const OR_PROPERTY_ID = "c0b8169048144706b444df259a6db68d";
const OR_BOOKING_WIDGET_ID = "554188faec574f7bb85d3c805ec98845";
const OR_REVIEWS_WIDGET_ID = "5ee9e6bc937841e98af4a9a54eadf3c3";
const OR_CALENDAR_WIDGET_ID = "4c14755058f04893a35ffd79fc0ebf19";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle} | Coastal Beach Retreats</title>
    <meta
      name="description"
      content="Fanta Sea at Waterscape Resort (A328) — photos, details, and booking."
    />
  </head>

  <body>
    <SiteHeader phone="(918) 734-3331" />

    <main class="wrap">
      <header class="titlebar">
        <h1 class="h1">{pageTitle}</h1>
        <p class="sub">{subtitle}</p>
      </header>

      <!-- PHOTO COLLAGE + MOBILE HERO SLIDER -->
      <section class="collage" id="photos" aria-label="Photo preview">
        <a class="big" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
          <img
            id="heroImg"
            src={photosTop[0].src}
            alt={photosTop[0].alt}
            loading="eager"
          />

          <button
            class="arrow left"
            type="button"
            aria-label="Previous photo"
            data-arrow="prev"
          >
            ‹
          </button>
          <button
            class="arrow right"
            type="button"
            aria-label="Next photo"
            data-arrow="next"
          >
            ›
          </button>

          <span class="mobileCam" aria-label={photosCountAria}>
            <span class="cam" aria-hidden="true">📷</span>
            {PHOTO_COUNT}
          </span>
        </a>

        <div class="smallGrid" aria-hidden="true">
          <a class="small" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
            <img src={photosTop[1].src} alt={photosTop[1].alt} loading="lazy" />
          </a>
          <a class="small" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
            <img src={photosTop[2].src} alt={photosTop[2].alt} loading="lazy" />
          </a>
          <a class="small" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
            <img src={photosTop[3].src} alt={photosTop[3].alt} loading="lazy" />
          </a>
          <a class="small last" href={PHOTOS_PAGE_HREF} aria-label="View all photos">
            <img src={photosTop[4].src} alt={photosTop[4].alt} loading="lazy" />
            <span class="countBadge" aria-label={photosCountAria}>
              <span class="cam" aria-hidden="true">📷</span>
              {PHOTO_COUNT}
            </span>
          </a>
        </div>
      </section>

      <nav class="subnav" aria-label="Page sections">
        <a href={PHOTOS_PAGE_HREF}>PHOTOS</a>
        <a href="#details">DETAILS</a>
        <a href="#availability">AVAILABILITY</a>
        <a href="#location">LOCATION</a>
        <a href="#amenities">AMENITIES</a>
        <a href="#reviews">REVIEWS</a>
      </nav>

      <section class="below" id="details" aria-label="Details and booking">
        <div class="desc">
          <div class="metaLine">
            <span class="metaLabel">Size –</span>
            <span>{sizeLine}</span>
          </div>

          <div class="metaLine">
            <span class="metaLabel">Amenities –</span>
            <span class="amenInline">
              {amenitiesLine.map((a, i) => (
                <span class="amenItem">
                  <span class="chip">{a}</span>
                  {i < amenitiesLine.length - 1 ? <span class="dot">•</span> : null}
                </span>
              ))}
              <a class="more" href="#amenities">(more...)</a>
            </span>
          </div>

          <!-- ✅ FULL DESCRIPTION INSERTED -->
          <div class="longDesc">
            <p>
              Coastal Beach Retreats is proud to present <strong>Fanta Sea</strong>, a beautifully updated
              1-bedroom, 2-bath with bunk nook condo located in the highly sought-after Waterscape Resort on
              Okaloosa Island. Designed for comfort and relaxation, this inviting retreat offers peaceful pool
              views, resort-style amenities, and easy access to one of the most family-friendly beaches on the
              Emerald Coast.
            </p>

            <p><strong>🛌 Comfortable &amp; Thoughtfully Designed for Families</strong></p>
            <p>
              Fanta Sea comfortably accommodates up to 6 guests (per HOA guidelines). The layout includes a king
              primary suite with private ensuite bath, balcony access, and flat-screen TV. A twin-over-twin bunk
              alcove is perfect for kids, and a sleeper sofa in the living area provides additional sleeping
              space. A second full bathroom adds extra convenience.
            </p>
            <p>
              The open living space is ideal for unwinding after a day in the sun, while the private balcony
              offers a relaxing spot for morning coffee or evening cocktails with serene pool views.
            </p>

            <p><strong>🍽️ Fully Equipped for Easy Vacation Living</strong></p>
            <p>
              The fully stocked kitchen features stainless steel appliances and granite countertops, making
              vacation meals easy to prepare. A cozy dining area is perfect for gathering and planning your next
              adventure. An in-unit washer and dryer ensure a stress-free stay from start to finish.
            </p>

            <p><strong>🌴 Waterscape Resort – A Destination in Itself</strong></p>
            <p>
              Waterscape feels like a Caribbean-style oasis with amenities for all ages. Guests enjoy four resort
              pools, including a lazy river, a zero-entry pool with waterfalls, and a toddler splash area.
              Additional amenities include two hot tubs, a seasonal poolside tiki bar, a fitness center with pool
              views, poolside grills, a kids’ game room with organized activities, weekly poolside movie nights,
              secured covered parking, and 24-hour onsite security.
            </p>

            <p><strong>🏖️ Complimentary Beach Gear for Your Stay</strong></p>
            <p>
              To make your beach days effortless, we provide 6 beach towels, 4 beach chairs, a shoulder-strap
              cooler, and a beach umbrella—everything you need to relax and enjoy the beautiful Emerald Coast
              without packing extra gear.
            </p>

            <p><strong>📍 Prime Okaloosa Island Location</strong></p>
            <p>
              Fanta Sea offers the best of both worlds—a laid-back island atmosphere just 10 minutes from
              Destin’s dining, shopping, and nightlife. Nearby attractions include the Okaloosa Island Fishing
              Pier, The Boardwalk with restaurants and shops, the Gulfarium Marine Adventure Park, and popular
              beachside dining such as Old Bay Steamer and AJ’s Oyster Shanty. You can even stroll down the beach
              to many local attractions.
            </p>

            <p><strong>❄️ Snowbirds Welcome</strong></p>
            <p>
              Discounted monthly winter rates are available November through February. Monthly stays require
              arrival on the 1st and departure on the 1st of a subsequent month. An additional $150 cleaning fee
              applies.
            </p>

            <p><strong>ℹ️ Important Guest Information</strong></p>
            <p>
              The primary renter must be at least 25 years old, sign a rental agreement within 48 hours of
              booking, and be present for the duration of the stay. A $200 damage hold is required on a debit or
              credit card in the renter’s name. Smoking, pets, and parties are not permitted.
            </p>
          </div>
        </div>

        <aside class="book">
          <div class="bookInner">
            <div
              class="ownerrez-widget"
              data-propertyId={OR_PROPERTY_ID}
              data-widget-type="Booking/Inquiry"
              data-widgetId={OR_BOOKING_WIDGET_ID}
            ></div>
          </div>
        </aside>
      </section>

      <section id="location" class="card">
        <h2 class="h2">Location</h2>
        <p>Waterscape Resort • A328 • Fort Walton Beach, FL</p>
      </section>

      <section id="amenities" class="card">
        <h2 class="h2">Amenities</h2>
        <p>Coming soon.</p>
      </section>

      <section id="reviews" class="card">
        <h2 class="h2">Reviews</h2>
        <div
          class="ownerrez-widget"
          data-propertyId={OR_PROPERTY_ID}
          data-widget-type="Reviews"
          data-widgetId={OR_REVIEWS_WIDGET_ID}
        ></div>
      </section>

      <section id="availability" class="card">
        <h2 class="h2">Availability</h2>
        <div
          class="ownerrez-widget"
          data-propertyId={OR_PROPERTY_ID}
          data-widget-type="Multiple Month Calendar"
          data-widgetId={OR_CALENDAR_WIDGET_ID}
        ></div>
      </section>
    </main>

    <SiteFooter phone="(918) 734-3331" email="coastal-beach-retreats@gmail.com" />

    <script is:inline src="https://app.ownerrez.com/widget.js"></script>

    <!-- ✅ Mobile hero slider script (runs only on small screens) -->
    <script is:inline define:vars={{ galleryPhotos }}>
      (function () {
        const isMobile = window.matchMedia("(max-width: 640px)").matches;
        if (!isMobile) return;

        const photos = JSON.parse(JSON.stringify(galleryPhotos || []));
        if (!photos.length) return;

        const heroImg = document.getElementById("heroImg");
        const bigLink = heroImg?.closest("a.big");
        if (!heroImg || !bigLink) return;

        let idx = 0;

        function setPhoto(i) {
          idx = (i + photos.length) % photos.length;
          heroImg.src = photos[idx].src;
          heroImg.alt = photos[idx].alt;
        }

        function onArrow(e, dir) {
          e.preventDefault();
          e.stopPropagation();
          setPhoto(idx + (dir === "next" ? 1 : -1));
        }

        const prevBtn = bigLink.querySelector('button[data-arrow="prev"]');
        const nextBtn = bigLink.querySelector('button[data-arrow="next"]');

        prevBtn?.addEventListener("click", (e) => onArrow(e, "prev"));
        nextBtn?.addEventListener("click", (e) => onArrow(e, "next"));

        let startX = 0;
        heroImg.addEventListener(
          "touchstart",
          (e) => {
            startX = e.touches?.[0]?.clientX || 0;
          },
          { passive: true }
        );

        heroImg.addEventListener(
          "touchend",
          (e) => {
            const endX = e.changedTouches?.[0]?.clientX || 0;
            const dx = endX - startX;
            if (Math.abs(dx) < 40) return;
            setPhoto(idx + (dx < 0 ? 1 : -1));
          },
          { passive: true }
        );

        setPhoto(0);
      })();
    </script>

    <style>
      .wrap { max-width: 1440px; margin: 0 auto; padding: 12px 10px; }
      .titlebar { margin: 10px 0 14px; }
      .h1 { margin: 0 0 6px; font-size: 34px; line-height: 1.1; color: var(--brand-blue, #193e7f); }
      .sub { margin: 0; opacity: .85; }

      .collage { display: grid; grid-template-columns: 1.55fr 1fr; gap: 2px; margin: 14px 0 12px; }
      .big, .small { display: block; border-radius: 0; overflow: hidden; border: 1px solid rgba(0,0,0,.12); background: rgba(0,0,0,.04); text-decoration: none; position: relative; }
      .big img { width: 100%; height: 420px; object-fit: cover; display: block; }

      .smallGrid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
      .small img { width: 100%; height: 205px; object-fit: cover; display: block; }

      .countBadge {
        position: absolute; right: 10px; bottom: 10px;
        display: inline-flex; align-items: center; gap: 8px;
        padding: 8px 10px; border-radius: 12px;
        background: rgba(0,0,0,.55); color: #fff; font-weight: 800;
        border: 1px solid rgba(255,255,255,.18); backdrop-filter: blur(6px);
      }

      .mobileCam {
        position: absolute; right: 10px; bottom: 10px;
        display: none; align-items: center; gap: 8px;
        padding: 10px 12px; border-radius: 999px;
        background: rgba(0,0,0,.60); color: #fff; font-weight: 900;
        border: 1px solid rgba(255,255,255,.18); backdrop-filter: blur(6px);
        pointer-events: none;
      }
      .cam { font-size: 16px; }

      .arrow {
        position: absolute; top: 50%; transform: translateY(-50%);
        width: 40px; height: 40px; border-radius: 999px;
        border: 1px solid rgba(255,255,255,.22);
        background: rgba(0,0,0,.45); color: #fff;
        font-size: 28px; line-height: 1;
        display: none; align-items: center; justify-content: center;
        cursor: pointer; -webkit-tap-highlight-color: transparent;
      }
      .arrow.left { left: 10px; }
      .arrow.right { right: 10px; }
      .arrow:active { transform: translateY(-50%) scale(0.98); }

      .subnav {
        display: flex; gap: 22px; align-items: center;
        padding: 14px 4px 8px; border-bottom: 1px solid rgba(0,0,0,.10);
        margin-bottom: 14px; flex-wrap: wrap;
      }
      .subnav a {
        text-decoration: none; font-weight: 800; letter-spacing: .08em;
        font-size: 14px; color: rgba(25,62,127,.75);
      }
      .subnav a:hover { color: var(--brand-blue, #193e7f); }

      .below { display: grid; grid-template-columns: 1.6fr 1fr; gap: 22px; align-items: start; margin: 8px 0 18px; }
      .desc { padding-right: 6px; }

      .metaLine { display: flex; align-items: baseline; gap: 10px; margin: 10px 0; font-size: 20px; line-height: 1.25; }
      .metaLabel { font-family: var(--font-heading, "Dancing Script", cursive); color: var(--accent-teal, #058789); font-weight: 700; font-size: 24px; white-space: nowrap; }

      .amenInline { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; }
      .amenItem { display: inline-flex; align-items: center; gap: 10px; }
      .chip { font-weight: 600; }
      .dot { opacity: .55; }

      .more { text-decoration: none; font-weight: 700; color: rgba(25,62,127,.75); }
      .more:hover { color: var(--brand-blue, #193e7f); }

      .longDesc p { font-size: 16px; line-height: 1.75; margin: 14px 0; }

      .bookInner {
        position: sticky; top: 92px;
        border: 1px solid rgba(0,0,0,.12); border-radius: 16px;
        padding: 14px; background: #fff; box-shadow: 0 6px 18px rgba(0,0,0,.06);
      }

      .card {
        border: 1px solid rgba(0,0,0,.12); border-radius: 16px;
        padding: 14px; background: #fff;
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
        margin-bottom: 14px;
      }
      .h2 { margin: 0 0 10px; font-size: 24px; color: var(--brand-blue, #193e7f); }

      @media (max-width: 980px) {
        .wrap { padding: 12px 12px; }
        .collage { grid-template-columns: 1fr; }
        .big img { height: 320px; }
        .small img { height: 160px; }
        .below { grid-template-columns: 1fr; }
        .bookInner { position: static; }
      }

      @media (max-width: 640px) {
        .smallGrid { display: none; }
        .mobileCam { display: inline-flex; }
        .arrow { display: inline-flex; }
        .big img { height: 320px; }

        /* ✅ booking widget above description (mobile only) */
        .below { display: grid; grid-template-columns: 1fr; }
        .below .book { order: 1; }
        .below .desc { order: 2; }
        .bookInner { position: static; margin-bottom: 12px; }
      }
    </style>
  </body>
</html>