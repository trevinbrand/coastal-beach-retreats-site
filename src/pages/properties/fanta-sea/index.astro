      .h2 { margin: 0 0 10px; font-size: 24px; color: var(--brand-blue, #193e7f); }

      /* ✅ Map styles (Heavenly Hideaway match) */
      .mapWrap {
        margin-top: 12px;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,.12);
        background: #fff;
      }
      .mapWrap iframe {
        width: 100%;
        height: 360px;
        border: 0;
        display: block;
      }
      .mapLink {
        display: block;
        padding: 10px 12px;
        text-align: right;
        font-weight: 800;
        text-decoration: none;
        color: rgba(25,62,127,.85);
      }
      .mapLink:hover { color: var(--brand-blue, #193e7f); }

      /* ✅ Amenities table (matches your screenshot) */
      .amenTable{
        margin-top: 10px;
        border: 1px solid rgba(0,0,0,.10);
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
      }

      .amenRow{
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 18px;
        padding: 18px 18px;
        border-top: 1px solid rgba(0,0,0,.08);
        align-items: start;
      }
      .amenRow:first-child{ border-top: 0; }

      .amenLabel{
        font-weight: 900;
        color: rgba(0,0,0,.78);
        line-height: 1.25;
      }

      .amenValue{
        color: rgba(0,0,0,.75);
        line-height: 1.45;
      }

      .amenList{
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px 26px;
      }
      .amenList li{ margin: 0; }

      @media (max-width: 980px) {
        .wrap { padding: 12px 12px; }
        .collage { grid-template-columns: 1fr; }
        .big img { height: 320px; }
        .small img { height: 160px; }
        .below { grid-template-columns: 1fr; }
        .bookInner { position: static; }
        .mapWrap iframe { height: 300px; }

        .amenRow { grid-template-columns: 1fr; }
        .amenList { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }

      @media (max-width: 640px) {
        .smallGrid { display: none; }
        .mobileCam { display: inline-flex; }
        .arrow { display: inline-flex; }
        .big img { height: 320px; }

        /* ✅ booking widget above description (mobile only) */
        .below { display: grid; grid-template-columns: 1fr; }
        .below .book { order: 1; }
        .below .desc { order: 2; }
        .bookInner { position: static; margin-bottom: 12px; }
      }

      @media (max-width: 520px) {
        .amenList { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>