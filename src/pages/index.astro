---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import PropertyBlock from "../components/PropertyBlock.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { properties } from "../data/properties.js";

type Property = (typeof properties)[number];

// Group properties by city
const groups: Record<string, Property[]> = {};

for (const p of properties) {
  const key = p.city ?? "Other";
  (groups[key] ??= []).push(p);
}

const pcbCity = "Panama City Beach, FL";
const destinCity = "Destin, FL";

// PCB properties
const pcbProps = groups[pcbCity] ?? [];

// Always include Waterscape / Fanta Sea with Destin / Okaloosa section
const destinProps = properties.filter((p) =>
  p.city === destinCity ||
  p.name.toLowerCase().includes("waterscape") ||
  p.name.toLowerCase().includes("fanta sea") ||
  p.href.toLowerCase().includes("fanta-sea")
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Coastal Beach Retreats</title>
    <meta
      name="description"
      content="Discover Coastal Beach Retreats – luxury beachfront vacation rentals in Panama City Beach, Destin, and Okaloosa Island."
    />
  </head>

  <body>
    <SiteHeader phone="(918) 734-3331" />

    <HeroCarousel />

    <main class="wrap">
      <section class="browseBar" aria-label="Browse properties">
        <div class="browseBarTop">
          <h2 class="section-title">Discover your next coastal escape</h2>
        </div>

        <div class="browseFilters" role="tablist" aria-label="Destination filters">
          <button class="filterBtn is-active" type="button" data-filter="all" aria-pressed="true">
            All
          </button>
          <button class="filterBtn" type="button" data-filter="pcb" aria-pressed="false">
            Panama City Beach
          </button>
          <button class="filterBtn" type="button" data-filter="destin" aria-pressed="false">
            Destin / Okaloosa Island
          </button>
        </div>
      </section>

      <section class="resultsWrap">
        <!-- PCB -->
        <section class="section propGroup" data-group="pcb">
          <div class="groupHeader">
            <p class="groupEyebrow">Panama City Beach</p>
            <h2 class="city-heading">Edgewater Beach and Golf Resort Condos</h2>
            <p class="groupHelper">
              Gulf-front favorites in the heart of Panama City Beach.
            </p>
          </div>

          <div class="groupProps">
            {pcbProps.map((p) => (
              <div class="prop">
                <PropertyBlock p={p} />
              </div>
            ))}
          </div>
        </section>

        <!-- DESTIN -->
        <section class="section propGroup" data-group="destin">
          <div class="groupHeader">
            <p class="groupEyebrow">Destin / Okaloosa Island</p>
            <h2 class="city-heading">Emerald Coast Condos</h2>
            <p class="groupHelper">
              Beachfront favorites across Sterling Shores, Sterling Sands, and Waterscape.
            </p>
          </div>

          <div class="groupProps">
            {destinProps.map((p) => (
              <div class="prop">
                <PropertyBlock p={p} />
              </div>
            ))}
          </div>
        </section>
      </section>

      <!-- REVIEWS -->
      <section class="section reviewsSection" id="reviews">
        <h2 class="reviews-title">Guest Reviews</h2>
        <hr class="rule" />

        <div
          class="ownerrez-widget"
          data-widget-type="Reviews - Reviews"
          data-widgetId="4bf99f90fcf54552a13fd7315759dbca"
        ></div>
      </section>
    </main>

    <SiteFooter
      phone="(918) 734-3331"
      email="coastalbeachretreats@gmail.com"
    />

    <script is:inline src="https://app.ownerrez.com/widget.js"></script>

    <script is:inline>
      (() => {
        const buttons = Array.from(document.querySelectorAll(".filterBtn"));
        const groups = Array.from(document.querySelectorAll(".propGroup"));

        function setFilter(filter) {
          buttons.forEach((btn) => {
            const active = btn.dataset.filter === filter;
            btn.classList.toggle("is-active", active);
            btn.setAttribute("aria-pressed", active ? "true" : "false");
          });

          groups.forEach((group) => {
            const show = filter === "all" || group.dataset.group === filter;
            group.hidden = !show;
          });
        }

        buttons.forEach((btn) => {
          btn.addEventListener("click", () => setFilter(btn.dataset.filter || "all"));
        });

        setFilter("all");
      })();
    </script>

    <style>
      .wrap {
        max-width: 1440px;
        margin: 0 auto;
        padding: 8px 14px 14px;
      }

      .section {
        padding: 10px 0;
      }

      .browseBar {
        margin: 0 0 18px;
        padding: 10px 0 14px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      }

      .browseBarTop {
        margin-bottom: 14px;
        text-align: center;
      }

      .browseEyebrow {
        margin: 0 0 6px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #058789;
      }

      .browseTitle {
        margin: 0;
        font-size: 34px;
        line-height: 1.08;
        font-family: "Dancing Script", cursive;
        color: #193e7f;
        font-weight: 700;
      }

      .browseFilters {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
      }

      .filterBtn {
        appearance: none;
        border: 1px solid rgba(25, 62, 127, 0.16);
        background: rgba(25, 62, 127, 0.04);
        color: #193e7f;
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
      }

      .filterBtn:hover {
        background: rgba(25, 62, 127, 0.08);
        border-color: rgba(25, 62, 127, 0.3);
        transform: translateY(-1px);
      }

      .filterBtn.is-active {
        background: #193e7f;
        border-color: #193e7f;
        color: #fff;
      }

      .resultsWrap {
        margin-top: 0;
      }

      .propGroup {
        margin: 0 0 22px;
      }

      .groupHeader {
        margin: 0 0 10px;
        padding: 0 0 8px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      }

      .groupEyebrow {
        margin: 0 0 3px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #058789;
      }

      .city-heading {
        margin: 0 0 4px;
        font-size: 22px;
        line-height: 1.1;
        font-family: "Dancing Script", cursive;
        color: #193e7f;
        font-weight: 700;
      }

      .groupHelper {
        margin: 0;
        font-size: 14px;
        line-height: 1.4;
        color: rgba(0, 0, 0, 0.62);
      }

      .groupProps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        align-items: stretch;
      }

      .prop {
        min-width: 0;
        height: 100%;
      }

      .reviewsSection {
        padding-top: 4px;
      }

      .reviews-title {
        margin: 0 0 8px;
        font-size: 26px;
        line-height: 1.1;
        color: #193e7f;
      }

      .rule {
        border: 0;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
        margin: 10px 0 16px;
      }

      @media (max-width: 1280px) {
        .groupProps {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 16px;
        }

        .browseTitle {
          font-size: 30px;
        }
      }

      @media (max-width: 820px) {
        .groupProps {
          grid-template-columns: 1fr;
          gap: 14px;
        }

        .wrap {
          padding: 8px 12px 12px;
        }

        .browseBar {
          margin-bottom: 14px;
          padding-bottom: 10px;
        }

        .browseTitle {
          font-size: 26px;
        }

        .city-heading {
          font-size: 20px;
        }

        .groupHelper {
          font-size: 13px;
        }

        .reviews-title {
          font-size: 22px;
        }
      }
    </style>
  </body>
</html>