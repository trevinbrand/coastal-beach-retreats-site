---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import PropertyBlock from "../components/PropertyBlock.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { properties } from "../data/properties.js";

type Property = (typeof properties)[number];

// Group properties by city (TypeScript-safe)
const groups: Record<string, Property[]> = {};

for (const p of properties) {
  const key = p.city ?? "Other";
  (groups[key] ??= []).push(p);
}

// Explicit groups
const pcbCity = "Panama City Beach, FL";

// ✅ Destin / Okaloosa group includes nearby markets too
const destinOkaloosaCities = [
  "Destin, FL",
  "Fort Walton Beach, FL",
  "Okaloosa Island, FL",
];

const pcbProps = groups[pcbCity] ?? [];
const destinProps = destinOkaloosaCities.flatMap((city) => groups[city] ?? []);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Coastal Beach Retreats</title>
    <meta
      name="description"
      content="Discover Coastal Beach Retreats – luxury beachfront vacation rentals in Panama City Beach and Destin."
    />
  </head>

  <body>
    <SiteHeader phone="(918) 734-3331" />

    <HeroCarousel />

    <main class="wrap">
      <section class="brand-divider">
        <img
          src="/images/coastal-beach-retreats-welcome.png"
          alt="Welcome to Coastal Beach Retreats"
          loading="eager"
        />
      </section>

      <!-- ✅ LOCATION SELECT (PHOTO CARDS) -->
      <section
        class="locCards"
        id="location-select"
        aria-label="Browse by location"
      >
        <p class="locLabel">Browse by location</p>
        <p class="locHelper">Choose a location to view available condos.</p>

        <div class="locGrid">
          <!-- Panama City Beach card -->
          <button
            class="locCard"
            type="button"
            data-location="pcb"
            aria-label="Browse Panama City Beach properties"
          >
            <img
              class="locImg"
              src="/images/home/location-pcb.jpg"
              alt="Panama City Beach"
              loading="lazy"
            />
            <div class="locOverlay" aria-hidden="true"></div>

            <div class="locText">
              <div class="locTitle">Panama City Beach</div>
              <div class="locSub">Edgewater Resort condos</div>
              <div class="locMeta">
                Heavenly Hideaway • Sailor’s Delight • Red Sky Nights
              </div>
            </div>

            <div class="locCta">View properties →</div>
          </button>

          <!-- Destin / Okaloosa card -->
          <button
            class="locCard"
            type="button"
            data-location="destin"
            aria-label="Browse Destin / Okaloosa Island properties"
          >
            <img
              class="locImg"
              src="/images/home/location-destin.jpg"
              alt="Destin / Okaloosa Island"
              loading="lazy"
            />
            <div class="locOverlay" aria-hidden="true"></div>

            <div class="locText">
              <div class="locTitle">Destin / Okaloosa Island</div>
              <div class="locSub">
                Sterling Shores • Sterling Sands • Waterscape
              </div>
              <div class="locMeta">Destin Dreams • Destin Diamond • Fanta Sea</div>
            </div>

            <div class="locCta">View properties →</div>
          </button>
        </div>
      </section>

      <!-- ✅ PROPERTY RESULTS -->
      <section id="property-results" class="resultsWrap" aria-live="polite">
        <div class="resultsTop">
          <h2 class="resultsHeading" id="resultsHeading">Available Condos</h2>

          <button
            class="clearBtn"
            id="clearSelection"
            type="button"
            hidden
          >
            Show all locations
          </button>
        </div>

        <!-- PCB -->
        <section class="section propGroup" data-group="pcb" hidden>
          {pcbProps.map((p) => (
            <div class="prop">
              <PropertyBlock p={p} />
            </div>
          ))}
        </section>

        <!-- Destin / Okaloosa -->
        <section class="section propGroup" data-group="destin" hidden>
          {destinProps.map((p) => (
            <div class="prop">
              <PropertyBlock p={p} />
            </div>
          ))}
        </section>
      </section>

      <!-- REVIEWS -->
      <section class="section" id="reviews">
        <h2 class="reviews-title">Guest Reviews</h2>
        <hr class="rule" />

        <div
          class="ownerrez-widget"
          data-widget-type="Reviews - Reviews"
          data-widgetId="4bf99f90fcf54552a13fd7315759dbca"
        ></div>
      </section>
    </main>

    <SiteFooter phone="(918) 734-3331" email="coastalbeachretreats@gmail.com" />

    <!-- ✅ Load OwnerRez widget script ONCE -->
    <script is:inline src="https://app.ownerrez.com/widget.js"></script>

    <script is:inline>
      (() => {
        const cards = document.querySelectorAll(".locCard");
        const groups = document.querySelectorAll(".propGroup");
        const resultsHeading = document.getElementById("resultsHeading");
        const resultsWrap = document.getElementById("property-results");
        const clearBtn = document.getElementById("clearSelection");

        function showGroup(groupName) {
          groups.forEach((group) => {
            group.hidden = group.dataset.group !== groupName;
          });

          cards.forEach((card) => {
            card.classList.toggle("active", card.dataset.location === groupName);
          });

          if (groupName === "pcb") {
            resultsHeading.textContent = "Panama City Beach Condos";
          } else if (groupName === "destin") {
            resultsHeading.textContent = "Destin / Okaloosa Island Condos";
          } else {
            resultsHeading.textContent = "Available Condos";
          }

          clearBtn.hidden = !groupName;

          resultsWrap?.scrollIntoView({
            behavior: "smooth",
            block: "start"
          });
        }

        cards.forEach((card) => {
          card.addEventListener("click", () => {
            const location = card.dataset.location;
            showGroup(location);
          });
        });

        clearBtn?.addEventListener("click", () => {
          groups.forEach((group) => {
            group.hidden = true;
          });

          cards.forEach((card) => card.classList.remove("active"));
          resultsHeading.textContent = "Available Condos";
          clearBtn.hidden = true;

          document.getElementById("location-select")?.scrollIntoView({
            behavior: "smooth",
            block: "start"
          });
        });
      })();
    </script>

    <style>
      .wrap {
        max-width: 1440px;
        margin: 0 auto;
        padding: 12px 10px;
      }

      .section {
        padding: 14px 0;
      }

      .prop {
        margin: 0 0 6px;
      }

      .reviews-title {
        margin: 0 0 8px;
      }

      .rule {
        border: 0;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
        margin: 12px 0 16px;
      }

      #location-select,
      #property-results {
        scroll-margin-top: 96px;
      }

      .locCards {
        margin: 10px 0 18px;
      }

      .locLabel {
        margin: 0 0 8px;
        text-align: center;
        font-weight: 900;
        letter-spacing: 0.02em;
        color: rgba(0, 0, 0, 0.72);
        font-size: 18px;
      }

      .locHelper {
        margin: 0 0 14px;
        text-align: center;
        color: rgba(0, 0, 0, 0.62);
        font-size: 15px;
      }

      .locGrid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      .locCard {
        position: relative;
        display: block;
        width: 100%;
        padding: 0;
        border-radius: 0;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.12);
        background: #fff;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
        min-height: 220px;
        isolation: isolate;
        transform: translateZ(0);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        cursor: pointer;
        text-align: left;
      }

      .locCard:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.12);
      }

      .locCard.active {
        border-color: rgba(25, 62, 127, 0.65);
        box-shadow: 0 0 0 2px rgba(25, 62, 127, 0.14), 0 14px 34px rgba(0, 0, 0, 0.12);
      }

      .locImg {
        width: 100%;
        height: 260px;
        display: block;
        object-fit: cover;
        border-radius: 0;
      }

      .locOverlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to top,
          rgba(0, 0, 0, 0.62) 0%,
          rgba(0, 0, 0, 0.28) 45%,
          rgba(0, 0, 0, 0.1) 100%
        );
        z-index: 1;
      }

      .locText {
        position: absolute;
        left: 16px;
        right: 16px;
        bottom: 18px;
        z-index: 2;
        color: #fff;
        padding-right: 160px;
      }

      .locTitle {
        font-size: 22px;
        font-weight: 900;
        letter-spacing: 0.01em;
        margin: 0 0 4px;
      }

      .locSub {
        font-size: 15px;
        font-weight: 700;
        opacity: 0.95;
        margin: 0 0 6px;
      }

      .locMeta {
        font-size: 14px;
        opacity: 0.92;
        line-height: 1.35;
      }

      .locCta {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 0;
        background: rgba(0, 0, 0, 0.55);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        font-weight: 900;
        font-size: 14px;
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
      }

      .resultsWrap {
        margin: 8px 0 6px;
      }

      .resultsTop {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 8px;
      }

      .resultsHeading {
        margin: 0;
      }

      .clearBtn {
        padding: 10px 14px;
        border: 1px solid rgba(0, 0, 0, 0.15);
        background: #fff;
        border-radius: 0;
        cursor: pointer;
        font-weight: 800;
        color: rgba(25, 62, 127, 0.9);
      }

      .clearBtn:hover {
        background: rgba(25, 62, 127, 0.05);
      }

      @media (max-width: 980px) {
        .wrap {
          padding: 12px 12px;
        }

        .locGrid {
          grid-template-columns: 1fr;
        }

        .locImg {
          height: 240px;
        }

        .locText {
          padding-right: 0;
        }
      }
    </style>
  </body>
</html>