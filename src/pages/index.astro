---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import PropertyBlock from "../components/PropertyBlock.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { properties } from "../data/properties.js";

type Property = (typeof properties)[number];

// Group properties by city
const groups: Record<string, Property[]> = {};

for (const p of properties) {
  const key = p.city ?? "Other";
  (groups[key] ??= []).push(p);
}

const pcbCity = "Panama City Beach, FL";
const destinCity = "Destin, FL";

// PCB properties
const pcbProps = groups[pcbCity] ?? [];

// Always include Waterscape / Fanta Sea with Destin / Okaloosa section
const destinProps = properties.filter((p) =>
  p.city === destinCity ||
  p.name.toLowerCase().includes("waterscape") ||
  p.name.toLowerCase().includes("fanta sea") ||
  p.href.toLowerCase().includes("fanta-sea")
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>Destin & Panama City Beach Vacation Rentals | Coastal Beach Retreats</title>

    <meta
      name="description"
      content="Browse beachfront vacation rentals in Destin, Okaloosa Island, and Panama City Beach. Coastal Beach Retreats offers professionally managed Gulf-front condos with direct booking."
    />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Destin & Panama City Beach Vacation Rentals | Coastal Beach Retreats" />
    <meta
      property="og:description"
      content="Browse beachfront vacation rentals in Destin, Okaloosa Island, and Panama City Beach. Professionally managed Gulf-front condos available to book direct."
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Destin & Panama City Beach Vacation Rentals | Coastal Beach Retreats" />
    <meta
      name="twitter:description"
      content="Browse beachfront vacation rentals in Destin, Okaloosa Island, and Panama City Beach. Professionally managed Gulf-front condos available to book direct."
    />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "LodgingBusiness",
        "name": "Coastal Beach Retreats",
        "telephone": "+1-918-734-3331",
        "email": "coastalbeachretreats@gmail.com",
        "areaServed": [
          "Destin, Florida",
          "Okaloosa Island, Florida",
          "Panama City Beach, Florida"
        ],
        "description": "Professionally managed beachfront vacation rentals in Destin, Okaloosa Island, and Panama City Beach."
      }
    </script>
    <link rel="icon" href="/images/logo.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/logo.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
  </head>

  <body>
    <SiteHeader phone="(918) 734-3331" />

    <HeroCarousel />

    <main class="wrap">
      <section class="trustBar" aria-label="Why book with us">
        <div class="trustBarInner">
          <div class="trustItem">Book direct for a seamless stay</div>
          <div class="trustDot" aria-hidden="true"></div>
          <div class="trustItem">Professionally managed beachfront condos</div>
          <div class="trustDot" aria-hidden="true"></div>
          <div class="trustItem">Destin, Okaloosa Island & Panama City Beach</div>
        </div>
      </section>

      <section class="browseBar" aria-label="Browse properties">
        <div class="browseBarTop">
          <h1 class="srOnly">Destin, Okaloosa Island & Panama City Beach Vacation Rentals | Coastal Beach Retreats</h1>
          <h2 class="section-title">Discover your next coastal escape</h2>
        </div>

        <div class="browseFilters" role="tablist" aria-label="Destination filters">
          <button class="filterBtn is-active" type="button" data-filter="all" aria-pressed="true">
            All
          </button>
          <button class="filterBtn" type="button" data-filter="pcb" aria-pressed="false">
            Panama City Beach
          </button>
          <button class="filterBtn" type="button" data-filter="destin" aria-pressed="false">
            Destin / Okaloosa Island
          </button>
        </div>
      </section>

      <section class="resultsWrap">
        <!-- PCB -->
        <section class="section propGroup" data-group="pcb" id="panama-city-beach-vacation-rentals">
          <div class="groupHeader">
            <p class="groupEyebrow">Panama City Beach</p>
            <h2 class="city-heading">Panama City Beach Vacation Rentals at Edgewater Beach and Golf Resort</h2>
            <p class="groupHelper">
              Browse Gulf-front condo rentals in the heart of Panama City Beach.
            </p>
          </div>

          <div class="groupProps">
            {pcbProps.map((p) => (
              <div class="prop">
                <PropertyBlock p={p} />
              </div>
            ))}
          </div>
        </section>

        <!-- DESTIN -->
        <section class="section propGroup" data-group="destin" id="destin-vacation-rentals">
          <div class="groupHeader">
            <p class="groupEyebrow">Destin / Okaloosa Island</p>
            <h2 class="city-heading">Destin & Okaloosa Island Beachfront Vacation Rentals</h2>
            <p class="groupHelper">
              Explore beachfront condos across Sterling Shores, Sterling Sands, and Waterscape.
            </p>
          </div>

          <div class="groupProps">
            {destinProps.map((p) => (
              <div class="prop">
                <PropertyBlock p={p} />
              </div>
            ))}
          </div>
        </section>
      </section>

      <section class="seoContent section" aria-label="Beachfront vacation rental information">
        <div class="seoCard">
          <h2 class="seoTitle">About Our Beachfront Vacation Rentals</h2>
          <p class="seoText">
            Coastal Beach Retreats offers professionally managed beachfront vacation rentals along Florida’s Emerald Coast,
            including Destin, Okaloosa Island, and Panama City Beach. Whether you are planning a family beach trip,
            couples getaway, or Gulf-front vacation with resort amenities, our condos are designed to make booking direct simple.
          </p>
          <p class="seoText">
            Guests can browse condos in top beachfront resorts with easy beach access, pools, and convenient locations near local
            dining, shopping, and attractions. Start by viewing <a href="/properties/">all vacation rentals</a>, explore the
            <a href="/map/">property map</a>, or check <a href="/availability/">availability</a> for your travel dates.
          </p>
        </div>
      </section>

      <!-- REVIEWS -->
      <section class="section reviewsSection" id="reviews">
        <h2 class="reviews-title">Guest Reviews</h2>
        <hr class="rule" />

        <div
          class="ownerrez-widget"
          data-widget-type="Reviews - Reviews"
          data-widgetId="4bf99f90fcf54552a13fd7315759dbca"
        ></div>
      </section>
    </main>

    <SiteFooter
      phone="(918) 734-3331"
      email="coastalbeachretreats@gmail.com"
    />

    <script is:inline src="https://app.ownerrez.com/widget.js"></script>

    <script is:inline>
      (() => {
        const buttons = Array.from(document.querySelectorAll(".filterBtn"));
        const groups = Array.from(document.querySelectorAll(".propGroup"));

        function setFilter(filter) {
          buttons.forEach((btn) => {
            const active = btn.dataset.filter === filter;
            btn.classList.toggle("is-active", active);
            btn.setAttribute("aria-pressed", active ? "true" : "false");
          });

          groups.forEach((group) => {
            const show = filter === "all" || group.dataset.group === filter;
            group.hidden = !show;
          });
        }

        buttons.forEach((btn) => {
          btn.addEventListener("click", () => setFilter(btn.dataset.filter || "all"));
        });

        setFilter("all");
      })();
    </script>

    <style>
      .wrap {
        max-width: 1440px;
        margin: 0 auto;
        padding: 0 14px 14px;
      }

      .section {
        padding: 8px 0;
      }

      .trustBar {
        padding: 18px 0 10px;
      }

      .trustBarInner {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px 12px;
        padding: 0 6px 10px;
        text-align: center;
        font-size: 14px;
        opacity: 0.85;
      }

      .trustItem {
        font-size: 14px;
        line-height: 1.4;
        font-weight: 600;
        color: #193e7f;
      }

      .trustDot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: #058789;
      }

      .browseBar {
        margin: 0 0 8px;
        padding: 6px 0 12px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      }

      .browseBarTop {
        margin-bottom: 18px;
        text-align: center;
      }

      .srOnly {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .section-title {
        margin: 0;
        font-size: 34px;
        line-height: 1.08;
        font-family: "Dancing Script", cursive;
        color: #193e7f;
        font-weight: 700;
      }

      .browseIntro {
        max-width: 820px;
        margin: 10px auto 0;
        font-size: 15px;
        line-height: 1.5;
        color: rgba(0, 0, 0, 0.72);
      }

      .browseEyebrow {
        margin: 0 0 6px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #058789;
      }

      .browseTitle {
        margin: 0;
        font-size: 34px;
        line-height: 1.08;
        font-family: "Dancing Script", cursive;
        color: #193e7f;
        font-weight: 700;
      }

      .browseFilters {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
      }

      .filterBtn {
        appearance: none;
        border: 1px solid rgba(25, 62, 127, 0.16);
        background: rgba(25, 62, 127, 0.04);
        color: #193e7f;
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
      }

      .filterBtn:hover {
        background: rgba(25, 62, 127, 0.08);
        border-color: rgba(25, 62, 127, 0.3);
        transform: translateY(-1px);
      }

      .filterBtn.is-active {
        background: #193e7f;
        border-color: #193e7f;
        color: #fff;
      }

      .seoContent {
        padding-top: 8px;
        padding-bottom: 8px;
      }

      .seoCard {
        max-width: 900px;
        margin: 0 auto;
        text-align: left;
        padding: 18px 22px;
        border: 1px solid rgba(25, 62, 127, 0.08);
        border-radius: 18px;
        background: rgba(25, 62, 127, 0.03);
      }

      .seoTitle {
        margin: 0 0 10px;
        font-size: 20px;
        line-height: 1.2;
        color: #193e7f;
      }

      .seoText {
        margin: 0 0 10px;
        font-size: 15px;
        line-height: 1.65;
        color: rgba(0, 0, 0, 0.72);
      }

      .seoText:last-child {
        margin-bottom: 0;
      }

      .seoText a {
        color: #193e7f;
        font-weight: 700;
        text-decoration: underline;
      }

      .resultsWrap {
        margin-top: 0;
      }

      .propGroup {
        margin: 0 0 18px;
      }

      .groupHeader {
        margin: 0 0 10px;
        padding: 0 0 8px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      }

      .groupEyebrow {
        margin: 0 0 3px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #058789;
      }

      .city-heading {
        margin: 0 0 4px;
        font-size: 22px;
        line-height: 1.1;
        font-family: "Dancing Script", cursive;
        color: #193e7f;
        font-weight: 700;
      }

      .groupHelper {
        margin: 0;
        font-size: 14px;
        line-height: 1.4;
        color: rgba(0, 0, 0, 0.54);
        opacity: 0.8;
      }

      .groupProps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        align-items: stretch;
      }

      .prop {
        min-width: 0;
        height: 100%;
      }

      .reviewsSection {
        padding-top: 2px;
      }

      .reviews-title {
        margin: 0 0 8px;
        font-size: 26px;
        line-height: 1.1;
        color: #193e7f;
      }

      .rule {
        border: 0;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
        margin: 10px 0 16px;
      }

      @media (max-width: 1280px) {
        .groupProps {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 16px;
        }

        .section-title,
        .browseTitle {
          font-size: 30px;
        }
      }

      @media (max-width: 820px) {
        .groupProps {
          grid-template-columns: 1fr;
          gap: 14px;
        }

        .wrap {
          padding: 0 12px 12px;
        }

        .trustBar {
          padding: 10px 0 6px;
        }

        .trustBarInner {
          gap: 8px 12px;
          padding-bottom: 8px;
          font-size: 13px;
          opacity: 0.9;
        }

        .trustItem {
          font-size: 13px;
        }

        .trustDot {
          display: none;
        }

        .browseBar {
          margin-bottom: 12px;
          padding-bottom: 10px;
        }

        .browseBarTop {
          margin-bottom: 18px;
        }

        .section-title,
        .browseTitle {
          font-size: 26px;
        }

        .browseIntro,
        .seoText {
          font-size: 14px;
        }

        .seoTitle {
          font-size: 18px;
        }

        .seoCard {
          padding: 16px 16px;
        }

        .city-heading {
          font-size: 20px;
        }

        .groupHelper {
          font-size: 13px;
        }

        .reviews-title {
          font-size: 22px;
        }
      }
    </style>
  </body>
</html>